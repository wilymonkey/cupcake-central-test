{% doc %}
  @prompt
    generate a 4 column section lined horizontally each has image, title and text block
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-four-column-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-four-column-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.column_gap }}px;
    width: 100%;
  }

  .ai-four-column-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: {{ block.settings.text_alignment }};
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-four-column-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: {{ block.settings.image_spacing }}px;
    position: relative;
  }

  .ai-four-column-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: block;
  }

  .ai-four-column-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-four-column-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-four-column-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
    line-height: 1.3;
  }

  .ai-four-column-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-four-column-container-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ block.settings.column_gap | times: 0.75 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-four-column-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.column_gap | times: 0.5 }}px;
    }

    .ai-four-column-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }

    .ai-four-column-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<four-column-section-{{ ai_gen_id }} class="ai-four-column-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-four-column-container-{{ ai_gen_id }}">
    {% for i in (1..4) %}
      {% liquid
        assign image_key = 'column_' | append: i | append: '_image'
        assign title_key = 'column_' | append: i | append: '_title'
        assign text_key = 'column_' | append: i | append: '_text'
        
        assign column_image = block.settings[image_key]
        assign column_title = block.settings[title_key]
        assign column_text = block.settings[text_key]
      %}
      
      <div class="ai-four-column-item-{{ ai_gen_id }}">
        <div class="ai-four-column-image-wrapper-{{ ai_gen_id }}">
          {% if column_image %}
            <img
              src="{{ column_image | image_url: width: 600 }}"
              alt="{{ column_image.alt | escape }}"
              loading="lazy"
              width="{{ column_image.width }}"
              height="{{ column_image.height }}"
              class="ai-four-column-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-four-column-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        
        {% if column_title != blank %}
          <h3 class="ai-four-column-title-{{ ai_gen_id }}">{{ column_title }}</h3>
        {% endif %}
        
        {% if column_text != blank %}
          <div class="ai-four-column-text-{{ ai_gen_id }}">{{ column_text }}</div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</four-column-section-{{ ai_gen_id }}>

<script>
  (function() {
    class FourColumnSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('four-column-section-{{ ai_gen_id }}', FourColumnSection{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Four column section",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "range",
      "id": "image_spacing",
      "label": "Image spacing",
      "min": 5,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "range",
