{% doc %}
  @prompt
    Create a trust marker section block that supports custom images alongside a title and subtitle text. Each trust marker should have an image picker (instead of or in addition to icon options), a title field, and a subtitle field. The block should display the image above or beside the text, styled cleanly to match a typical trust/delivery marker section.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-trust-marker-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-trust-marker-container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: {{ block.settings.layout }};
    align-items: {{ block.settings.alignment }};
    gap: {{ block.settings.spacing }}px;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-trust-marker-image-wrapper-{{ ai_gen_id }} {
    flex-shrink: 0;
  }

  .ai-trust-marker-image-{{ ai_gen_id }} {
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    object-fit: contain;
  }

  .ai-trust-marker-image-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    background-color: #f4f4f4;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-trust-marker-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-trust-marker-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 4px;
    {% if block.settings.layout == 'column' %}
      text-align: center;
    {% else %}
      text-align: left;
    {% endif %}
  }

  .ai-trust-marker-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    color: {{ block.settings.title_color }};
    margin: 0;
    line-height: 1.3;
  }

  .ai-trust-marker-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    line-height: 1.4;
  }

  @media screen and (max-width: 749px) {
    .ai-trust-marker-container-{{ ai_gen_id }} {
      padding: {{ block.settings.padding | times: 0.7 }}px;
      gap: {{ block.settings.spacing | times: 0.8 }}px;
    }

    .ai-trust-marker-image-{{ ai_gen_id }},
    .ai-trust-marker-image-placeholder-{{ ai_gen_id }} {
      width: {{ block.settings.image_size | times: 0.8 }}px;
      height: {{ block.settings.image_size | times: 0.8 }}px;
    }

    .ai-trust-marker-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }

    .ai-trust-marker-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<trust-marker-{{ ai_gen_id }} class="ai-trust-marker-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-trust-marker-container-{{ ai_gen_id }}">
    <div class="ai-trust-marker-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 200 }}"
          alt="{{ block.settings.image.alt | escape }}"
          class="ai-trust-marker-image-{{ ai_gen_id }}"
          loading="lazy"
          width="{{ block.settings.image_size }}"
          height="{{ block.settings.image_size }}"
        >
      {% else %}
        <div class="ai-trust-marker-image-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="ai-trust-marker-content-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h3 class="ai-trust-marker-title-{{ ai_gen_id }}">{{ block.settings.title }}</h3>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <p class="ai-trust-marker-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      {% endif %}
    </div>
  </div>
</trust-marker-{{ ai_gen_id }}>

<script>
  (function() {
    class TrustMarker{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }
    customElements.define('trust-marker-{{ ai_gen_id }}', TrustMarker{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Trust marker",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_size",
      "min": 30,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Image size",
      "default": 60
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Free shipping"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "On orders over $50"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "row",
          "label": "Horizontal"
        },
        {
          "value": "column",
          "label": "Vertical"
        }
      ],
      "default": "row"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "spacing",
      "min": 4,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Spacing",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 8
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 16
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle color",
      "default": "#444444"
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 10,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Subtitle size",
      "default": 14
    }
  ],
  "presets": [
    {
      "name": "Trust marker"
    }
  ]
}
{% endschema %}
