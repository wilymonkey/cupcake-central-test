{% doc %}
  @prompt
    Create a four column section block that includes an image alignment setting (left, center, right) for each column. The block should have an image picker, title, and text field for each of the four columns, with a setting to control image alignment. The layout should be clean and responsive, displaying four columns on desktop and stacking on mobile. Also include background color picker, background image picker, and background overlay opacity settings.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-four-column-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .ai-four-column-background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .ai-four-column-background-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-four-column-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.background_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 1;
  }

  .ai-four-column-container-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    padding: 60px 20px;
    max-width: 1600px;
    margin: 0 auto;
  }

  .ai-four-column-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
  }

  .ai-four-column-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-four-column-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    border-radius: 8px;
  }

  .ai-four-column-image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-four-column-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
  }

  .ai-four-column-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-four-column-image-wrapper-{{ ai_gen_id }}.align-left {
    margin-right: auto;
  }

  .ai-four-column-image-wrapper-{{ ai_gen_id }}.align-center {
    margin-left: auto;
    margin-right: auto;
  }

  .ai-four-column-image-wrapper-{{ ai_gen_id }}.align-right {
    margin-left: auto;
  }

  .ai-four-column-title-{{ ai_gen_id }} {
    font-size: 20px;
    font-weight: 600;
    margin: 0;
    color: {{ block.settings.text_color }};
  }

  .ai-four-column-text-{{ ai_gen_id }} {
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
    color: {{ block.settings.text_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-four-column-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-four-column-container-{{ ai_gen_id }} {
      padding: 40px 16px;
    }

    .ai-four-column-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .ai-four-column-title-{{ ai_gen_id }} {
      font-size: 18px;
    }
  }
{% endstyle %}

<four-column-block-{{ ai_gen_id }} class="ai-four-column-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.background_image %}
    <div class="ai-four-column-background-{{ ai_gen_id }}">
      <img
        src="{{ block.settings.background_image | image_url: width: 2000 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
    </div>
  {% endif %}

  <div class="ai-four-column-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-four-column-container-{{ ai_gen_id }}">
    <div class="ai-four-column-grid-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign image_key = 'column_' | append: i | append: '_image'
          assign title_key = 'column_' | append: i | append: '_title'
          assign text_key = 'column_' | append: i | append: '_text'
          assign alignment_key = 'column_' | append: i | append: '_image_alignment'

          assign column_image = block.settings[image_key]
          assign column_title = block.settings[title_key]
          assign column_text = block.settings[text_key]
          assign column_alignment = block.settings[alignment_key]
        %}

        <div class="ai-four-column-item-{{ ai_gen_id }}">
          <div class="ai-four-column-image-wrapper-{{ ai_gen_id }} align-{{ column_alignment }}">
            {% if column_image %}
              <img
                src="{{ column_image | image_url: width: 600 }}"
                alt="{{ column_image.alt | escape }}"
                loading="lazy"
                width="{{ column_image.width }}"
                height="{{ column_image.height }}"
              >
            {% else %}
              <div class="ai-four-column-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          {% if column_title != blank %}
            <h3 class="ai-four-column-title-{{ ai_gen_id }}">{{ column_title }}</h3>
          {% endif %}

          {% if column_text != blank %}
            <p class="ai-four-column-text-{{ ai_gen_id }}">{{ column_text }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</four-column-block-{{ ai_gen_id }}>

