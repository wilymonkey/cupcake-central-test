{% doc %}
  @prompt
    generate a new section with a heading title "4 WAYS TO GIFT" and a text field "Brighten up your events and meetings with our hand baked desserts, crafted from recipes perfected over the last 15 years. Our menu includes a dedicated vegan and Coeliac Australia certified gluten free range. " Both in center. Below that is a 4 column in horizontal. On each column there is a feature to add image as a background to fit or fill and inside each column is a text field, a heading and button medium
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-gift-ways-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background: #FFFAF2;
  }

  .ai-gift-ways-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-gift-ways-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_bottom_spacing }}px;
    font-weight: 700;
    letter-spacing: 1px;
  }

  .ai-gift-ways-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0 auto;
    max-width: 800px;
    line-height: 1.6;
  }

  .ai-gift-ways-columns-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.column_gap }}px;
    margin-top: {{ block.settings.columns_top_spacing }}px;
  }

  .ai-gift-ways-column-{{ ai_gen_id }} {
    position: relative;
    min-height: {{ block.settings.column_height }}px;
    border-radius: {{ block.settings.column_border_radius }}px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: {{ block.settings.column_padding }}px;
  }

  .ai-gift-ways-column-bg-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-gift-ways-column-bg-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.image_fit }};
  }

  .ai-gift-ways-column-bg-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-gift-ways-column-bg-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-gift-ways-column-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
    z-index: 2;
  }

  .ai-gift-ways-column-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    text-align: center;
  }

  .ai-gift-ways-column-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.column_text_size }}px;
    color: {{ block.settings.column_text_color }};
    margin: 0 0 {{ block.settings.column_text_spacing }}px;
    line-height: 1.4;
  }

  .ai-gift-ways-column-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.column_heading_size }}px;
    color: {{ block.settings.column_heading_color }};
    margin: 0 0 {{ block.settings.column_heading_spacing }}px;
    font-weight: 600;
  }

  .ai-gift-ways-column-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 24px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 500;
    transition: all 0.3s ease;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
  }

  .ai-gift-ways-column-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-gift-ways-columns-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-gift-ways-columns-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-gift-ways-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-gift-ways-description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_size }}px * 0.9);
    }
  }
{% endstyle %}

<gift-ways-{{ ai_gen_id }} class="ai-gift-ways-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-gift-ways-header-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-gift-ways-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}
    {% if block.settings.description != blank %}
      <div class="ai-gift-ways-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
    {% endif %}
  </div>

  <div class="ai-gift-ways-columns-{{ ai_gen_id }}">
    {% for i in (1..4) %}
      {% liquid
        assign image_key = 'column_' | append: i | append: '_image'
        assign text_key = 'column_' | append: i | append: '_text'
        assign heading_key = 'column_' | append: i | append: '_heading'
        assign button_text_key = 'column_' | append: i | append: '_button_text'
        assign button_link_key = 'column_' | append: i | append: '_button_link'

        assign column_image = block.settings[image_key]
        assign column_text = block.settings[text_key]
        assign column_heading = block.settings[heading_key]
        assign column_button_text = block.settings[button_text_key]
        assign column_button_link = block.settings[button_link_key]
      %}

      <div class="ai-gift-ways-column-{{ ai_gen_id }}">
        <div class="ai-gift-ways-column-bg-{{ ai_gen_id }}">
          {% if column_image %}
            <img
              src="{{ column_image | image_url: width: 600 }}"
              alt="{{ column_image.alt | escape }}"
              loading="lazy"
              width="{{ column_image.width }}"
              height="{{ column_image.height }}"
            >
          {% else %}
            <div class="ai-gift-ways-column-bg-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        <div class="ai-gift-ways-column-overlay-{{ ai_gen_id }}"></div>
        <div class="ai-gift-ways-column-content-{{ ai_gen_id }}">
          {% if column_text != blank %}
            <div class="ai-gift-ways-column-text-{{ ai_gen_id }}">{{ column_text }}</div>
          {% endif %}
          {% if column_heading != blank %}
            <h3 class="ai-gift-ways-column-heading-{{ ai_gen_id }}">{{ column_heading }}</h3>
          {% endif %}
          {% if column_button_text != blank %}
            <a
              href="{{ column_button_link }}"
              class="ai-gift-ways-column-button-{{ ai_gen_id }}"
            >
              {{ column_button_text }}
            </a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</gift-ways-{{ ai_gen_id }}>

