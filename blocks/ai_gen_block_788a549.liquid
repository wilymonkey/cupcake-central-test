{% doc %}
  @prompt
    Generate a 4 column section background color feature and each column has image, heading, text field. image, heading and text field has a feature to modify alignment to left, center or right
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-four-column-features-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-four-column-features__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    width: {{ block.settings.desktop_width_percent }}%;
  }

  .ai-four-column-features__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-four-column-features__column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-four-column-features__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    text-align: {{ block.settings.image_alignment }};
  }

  .ai-four-column-features__image-{{ ai_gen_id }} {
    max-width: {{ block.settings.image_width }}px;
    width: auto;
    height: 50px;
    border-radius: {{ block.settings.image_border_radius }}px;
    margin-right: auto;
    margin-left: auto;
  }

  .ai-four-column-features__image-placeholder-{{ ai_gen_id }} {
    max-width: {{ block.settings.image_width }}px;
    width: 100%;
    display: inline-block;
  }

  .ai-four-column-features__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
    background-color: #f4f4f4;
  }

  .ai-four-column-features__heading-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    text-align: {{ block.settings.heading_alignment }};
    font-weight: 600;
  }

  .ai-four-column-features__text-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    text-align: {{ block.settings.text_alignment }};
    line-height: 1.6;
  }

  @media screen and (max-width: 989px) {
    .ai-four-column-features__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-four-column-features__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-four-column-features__container-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-four-column-features-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-four-column-features__container-{{ ai_gen_id }}">
    <div class="ai-four-column-features__grid-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign image_key = 'column_' | append: i | append: '_image'
          assign heading_key = 'column_' | append: i | append: '_heading'
          assign text_key = 'column_' | append: i | append: '_text'
          
          assign column_image = block.settings[image_key]
          assign column_heading = block.settings[heading_key]
          assign column_text = block.settings[text_key]
        %}
        
        <div class="ai-four-column-features__column-{{ ai_gen_id }}">
          <div class="ai-four-column-features__image-wrapper-{{ ai_gen_id }}">
            {% if column_image %}
              <img
                src="{{ column_image | image_url: width: 600 }}"
                alt="{{ column_image.alt | escape }}"
                loading="lazy"
                width="{{ column_image.width }}"
                height="{{ column_image.height }}"
                class="ai-four-column-features__image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-four-column-features__image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          
          {% if column_heading != blank %}
            <h3 class="ai-four-column-features__heading-{{ ai_gen_id }}">
              {{ column_heading }}
            </h3>
          {% endif %}
          
          {% if column_text != blank %}
            <div class="ai-four-column-features__text-{{ ai_gen_id }}">
              {{ column_text }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

