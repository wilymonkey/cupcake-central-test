{%- comment -%}
  Renders a dynamic SVG icon.

  Accepts:
  - name: (string) The name of the icon to render. Required.
  - class: (string) Optional custom CSS classes for the SVG element.
{%- endcomment -%}

{%- liquid
  assign icon_class = class | default: 'w-6 h-6'

  case name
    when 'home'
      echo '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="' | append: icon_class | append: '"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>'
    when 'shopping-cart'
      echo '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="' | append: icon_class | append: '"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>'
    when 'search'
      echo '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="' | append: icon_class | append: '"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>'
    when 'x'
      echo '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="' | append: icon_class | append: '"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>'

    else
      echo ''
  endcase
-%}