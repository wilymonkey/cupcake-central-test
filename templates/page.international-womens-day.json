      "blocks": {
        "faq_entry_mkWpPr": {
          "type": "faq_entry",
          "settings": {
            "title": "When's the earliest I can receive my IWD order?",
            "answer": "All our desserts are made by hand in our Melbourne kitchen, so you'll need to order by 12pm the day before your desired delivery date so we can get everything ready in time for you. If you need something sooner, consider our classic cupcake gift boxes or mini cupcake gift boxes instead, which are available for same day delivery as long as you order by 12pm (subject to availability)."
          }
        },
        "faq_entry_i3W4Pa": {
          "type": "faq_entry",
          "settings": {
            "title": "When & where to you deliver to?",
            "answer": "We deliver 7 days a week to most suburbs in Metro Melbourne. To check if your suburb falls within our delivery zone, click on the \"Delivery Information\" link in our footer menu."
          }
        },
        "faq_entry_k6cU3x": {
          "type": "faq_entry",
          "settings": {
            "title": "How much will Melbourne delivery cost?",
            "answer": "For locations in Metro Melbourne, we offer free weekday delivery with orders over $40. If your order value is below $40, then the delivery fee will vary between $10-$15 depending on your location. On weekends, there is a $8 flat rate for delivery. We also offer free click and collect from our Highpoint store and West Footscray office locations. Please note that there is a minimum order value of $35 for delivery orders, and a minimum order value of $16 for click and collect orders."
          }
        },
        "faq_entry_qp4h3T": {
          "type": "faq_entry",
          "settings": {
            "title": "How much will Aus-wide delivery cost?",
            "answer": "For any locations outside of our standard delivery zone, Australia-wide delivery is available via AusPost with a flat fee of $15."
          }
        },
        "faq_entry_T4WQDp": {
          "type": "faq_entry",
          "settings": {
            "title": "Will you be delivering on the Labour Day public holiday?",
            "answer": "Delivery will not be available on the public holiday, however our IWD cupcakes can last up to 3 days and our IWD cookies and shortbreads last 5 days, so we recommend scheduling your delivery for the day before so you can still enjoy your IWD sweets on Labour Day!"
          }
        },
        "faq_entry_LCJjVK": {
          "type": "faq_entry",
          "settings": {
            "title": "I have another question!",
            "answer": "You can view all our FAQs by clicking here, or contact our customer service team by calling 9077 4542 or emailing service@cupcakecentral.com.au. Please note than our customer service hours are between 9am and 4pm Monday to Friday, and 9am to 2pm on Saturdays. If you'd like to contact us outside of these hours, please send us an email and we'll get back to you as soon as we can!"
          }
        }
