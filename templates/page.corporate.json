    "faq_block_EPddUP": {
      "type": "faq-block",
      "blocks": {
        "faq_entry_kjWnrj": {
          "type": "faq_entry",
          "settings": {
            "title_id": "delivery",
            "title": "How do I place an order?",
            "answer": "All cupcake and cake orders can be placed either online, in person at one of our stores or over the phone on our dedicated customer service line (03) 9077 4542. Our customer service hours are MON – FRI: 9:00am – 4:00pm and SAT: 9:00am - 3:00pm"
          }
        },
        "faq_entry_8HzKjG": {
          "type": "faq_entry",
          "settings": {
            "title_id": "delivery",
            "title": "Do you deliver?",
            "answer": "Yes, we deliver our cupcakes and cakes in and around Melbourne. We currently offer FREE delivery for all orders within our sweet zone over $40. Check if you're in our \"Sweet Zone\" by using our postcode checker visiting delivery info."
          }
        },
        "faq_entry_EmNHtN": {
          "type": "faq_entry",
          "settings": {
            "title_id": "delivery",
            "title": "What is your Delivery zone?",
            "answer": "To find out if we deliver to you, please click on \"Delivery info\" in the Navigation bar and use our postcode checker. All of our available delivery destinations will be displayed on our delivery information page. You can also use this link: https://cupcakecentral.com.au/pages/delivery-information."
          }
        },
        "faq_entry_q3ML8a": {
          "type": "faq_entry",
          "settings": {
            "title_id": "delivery",
            "title": "Do you do Same Day delivery?",
            "answer": "Yes, we do! (except on weekends or when we are at capacity) Orders must be placed before 12pm. For full T&C's surrounding our Same Day delivery service please visit: https://cupcakecentral.com.au/pages/delivery-information"
          }
        },
        "faq_entry_8xnNBV": {
          "type": "faq_entry",
          "settings": {
            "title_id": "delivery",
            "title": "Where do you deliver to?",
            "answer": "Payment for an online order can be made via the following:-Credit Card (Visa, Mastercard, American Express) -Gift Voucher (1 voucher per order) -Direct Deposit via Bank TransferPayment for an order instore can be made via the following:-Cash -Gift Voucher -Debit / Credit Card (VISA, Mastercard, American Express)"
          }
        },
        "faq_entry_K9LPaR": {
          "type": "faq_entry",
          "settings": {
            "title_id": "delivery",
            "title": "Can I select my own flavours?",
            "answer": "If you add an assorted gift box into your cart, you will receive an assortment of our delicious flavours. However, if you would like to customise your order and specify flavours, please add each individual flavour into your cart."
          }
        },
        "faq_entry_ATyH6A": {
          "type": "faq_entry",
          "settings": {
            "title_id": "delivery",
            "title": "What is the best way to store your products and how long can I keep it for?",
            "answer": "The best way to store our cupcakes, cookies and slices is to keep them in an airtight container (or wrap the box in cling wrap) and store them at room temperature (about 20c). When stored correctly, they can last up to 2-3 days but it goes without saying that our baked goods are at their best, when consumed fresh on the day. Please be mindful that storing them in the fridge might dry out the cupcakes a little bit."
          }
        },
        "faq_entry_QJeQXU": {
          "type": "faq_entry",
          "settings": {
            "title_id": "delivery",
            "title": "I've just received my cake. How should I store it?",
            "answer": "As soon as you receive our cake, place it straight into the fridge. We recommend that you take it out of the fridge for the cake to adjust to room temperature, between 30 minutes to an 1 hour (depending on your environment) before you intend to enjoy it. Please keep it out of the sun or it will melt. If you have left over, the best way to store our cakes is to keep them in an airtight container (or wrap the box in cling wrap) and store them in the fridge and consume within 3-5 days."
          }
        },
        "faq_entry_VrmJwP": {
          "type": "faq_entry",
          "settings": {
            "title_id": "delivery",
            "title": "Where do you deliver to?",
            "answer": "We take food allergies very seriously. We have strict protocols to ensure cross contamination does not occur during every stage of our baking process as well as how we store the ingredients. However, we do bake in the same space. Therefore, we do ask those who have severe allergic reactions to avoid or take caution when consuming our baked goods. When ordering, please ensure you inform us of any allergies or if you would like us to pack certain flavours separately. We are always happy to accommodate."
          }
        },
        "faq_entry_tJR4kV": {
          "type": "faq_entry",
          "settings": {
            "title_id": "delivery",
            "title": "Can I pick up an order from one of your stores?",
            "answer": "We offer a click & collect service from our Highpoint store and West Footscray Dispatch Centre. Orders must be placed online before 9pm for next day pick up. Please find the below store operating hours:HighpointMon-Wed & Sat-Sun: 10am-5pmThu-Fri: 10am-6pmWest FootscrayMon-Fri: 9am-4pmSat: 9am-3pm"
          }
        },
        "faq_entry_W9UYBd": {
          "type": "faq_entry",
          "settings": {
            "title_id": "delivery",
            "title": "Where can I find an ingredient list for your cakes?",
            "answer": "As our flavours change every season, we ask that you request a copy of our ingredient list from our customer service team at (03) 9077 4542. A copy of our ingredient list can also be found in store."
          }
        },
        "faq_entry_gUbNJK": {
          "type": "faq_entry",
          "settings": {
            "title_id": "delivery",
            "title": "What if no one is home to receive my order or the wrong address is supplied?",
            "answer": "If we have been provided with incorrect/insufficient details or if there is no one home to receive the delivery and we were not able to leave the delivery somewhere safe, you will incur a fee. Please understand, redelivering an order is not ideal for us either. It means your original order goes to waste, then remade, repacked and sent out with a courier again."
          }
        },
        "faq_entry_bnmD8B": {
          "type": "faq_entry",
          "settings": {
            "title_id": "delivery",
            "title": "How can I provide you with feedback?",
            "answer": "Through our contact form. Whether it be good or bad, we take all feedback on board and appreciate that you have taken the time to send us your thoughts. Please provide us with as much detail as you can and ensure you include photos where appropriate."
          }
        },
        "faq_entry_Cm3x4F": {
          "type": "faq_entry",
          "settings": {
            "title_id": "delivery",
            "title": "Delivery Terms and Conditions",
            "answer": "TERMS AND CONDITIONS FOR ALL DELIVERIES1. Please ensure someone is home to receive the delivery.2. Double check your Order Confirmation Email that the details you have provided to us are correct: (ie. Address and valid Australian contact number.) Please be mindful: We will not and are not allowed to enter medical institutions. If you are delivering to an apartment, please come down and meet the courier in the lobby or allow us to leave it at reception. Please provide as much extra information in the delivery instructions field to assist our couriers.3. Weekend Delivery Surcharge is an $8 flat rate for both Saturday and Sunday orders.4. If we have been provided with incorrect/insufficient details or if there is no one present to receive the delivery and we were not able to leave the delivery somewhere safe, A re-delivery fee will be required. Our redelivery fee is $10, plus 50% off the total cost of the order.5. Delivery Windows are Monday-Friday between 9am-3pm or 12-6pm. Saturday & Sunday between 10am-5pm. *Due to unforeseen circumstances that are out of our control (such as, but not limited to: traffic, weather, parking, having to wait for other customers), we may be delayed and will not be liable for those delays.6. Specific delivery time: Even if stated in your notes, we cannot guarantee a specific delivery time. If you require a specific delivery time, please contact us and see if we can accommodate the request."
          }
        }
      },
