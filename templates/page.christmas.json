    "campaign_faqs_knFarp": {
      "type": "campaign-faqs",
      "blocks": {
        "faq_entry_A94N33": {
          "type": "faq_entry",
          "settings": {
            "title_id": "delivery",
            "title": "When's the earliest I can receive my Christmas cupcakes?",
            "answer": "All our desserts are made by hand in our Melbourne kitchen, so you'll need to order by 12pm two days before your desired delivery date so we can get your Christmas cupcakes ready in time.If you need something sooner, consider our cupcake gift boxes or mini cupcake gift boxes instead, which are available for same day delivery as long as you order by 12pm (subject to availability)."
          }
        },
        "faq_entry_gKfTTE": {
          "type": "faq_entry",
          "settings": {
            "title_id": "delivery",
            "title": "What if I need cupcakes today?",
            "answer": "Since our Christmas cupcakes require more time to prepare, they're not available for same day delivery. We do offer same day delivery for our cupcake gift boxes  and mini cupcake gift boxes though (subject to availability), so just place your order by 12pm and we'll deliver them to you later today!Alternatively, you can also visit our Highpoint store if you'd like to browse our desserts in person and collect them on the spot."
          }
        },
        "faq_entry_nw7Qh3": {
          "type": "faq_entry",
          "settings": {
            "title_id": "delivery",
            "title": "Are you delivering on Christmas day?",
            "answer": "We'll be closed on Christmas and Boxing Day, but don't worry - you can still get your Christmas treats! Just order by 12pm on December 23rd for delivery on Christmas Eve. Your cupcakes will last up to 3 days, so you can enjoy them all throughout the festive period!"
          }
        },
        "faq_entry_yyjgFa": {
          "type": "faq_entry",
          "settings": {
            "title_id": "delivery",
            "title": "When and where do you deliver to?",
            "answer": "We deliver 7 days a week to most suburbs in metro Melbourne. To check if your suburb falls within our delivery zone, <a href=\"https://cupcakecentral.com.au/pages/delivery-information\">click here</a>."
          }
        },
        "faq_entry_aXj3fB": {
          "type": "faq_entry",
          "settings": {
            "title_id": "delivery",
            "title": "What if I want to deliver to multiple locations?",
            "answer": "We're happy to arrange this for you! Just give us a call at 9077 4542 or email service@cupcakecentral.com.au and our customer service team will process the order for you."
          }
        },
        "faq_entry_tg8RiA": {
          "type": "faq_entry",
          "settings": {
            "title_id": "delivery",
            "title": "How much will delivery cost?",
            "answer": "We offer free weekday delivery with orders over $40. If your order value is below $40, then the delivery fee will vary between $10-$15 depending on your location. On weekends, there is a $8 flat rate for delivery.We also offer free click and collect from our Highpoint store and West Footscray office locations. For location information, please <a href=\"https://cupcakecentral.com.au/pages/locations\">click here</a>.Please note that there is a minimum order value of $35 for delivery orders, and a minimum order value of $16 for click and collect orders."
          }
        },
        "faq_entry_f4DgjE": {
          "type": "faq_entry",
          "settings": {
            "title_id": "delivery",
            "title": "Can I select which flavours to include in my Christmas cupcake box?",
            "answer": "Due to a high volume of orders, we are unable to accommodate custom Christmas cupcake boxes. If you would like to select which cupcakes flavours you receive, this is available with our <a href=\"https://cupcakecentral.com.au/collections/cupcake\">cupcakes</a> and <a href=\"https://cupcakecentral.com.au/collections/mini-cupcakes\">mini cupcakes</a>. Just add your desired flavours and quantities to your cart and we'll sort out the rest for you.Please note that minimum order values apply. For delivery orders, there is a minimum order value of $35. For click and collect orders, there is a minimum order value of $16."
          }
        },
        "faq_entry_fXhHyz": {
          "type": "faq_entry",
          "settings": {
            "title_id": "delivery",
            "title": "Can I order a vegan version of a non-vegan flavour?",
            "answer": "Due to a high volume of orders, we are unable to accommodate custom Christmas cupcakes. We do have other vegan options available outside of our Christmas collection though, which you can <a href=\"https://cupcakecentral.com.au/collections/mini-cupcakes\">click here</a> to view."
          }
        },
        "faq_entry_eKXJMk": {
          "type": "faq_entry",
          "settings": {
            "title_id": "delivery",
            "title": "What if I want to order just a couple of cupcakes, instead of a whole box?",
            "answer": "For all online orders, our Christmas cupcakes are available only in boxes of 12 for the standard cupcake size, and in boxes of 15 and 30 for mini cupcakes.If you'd like to purchase smaller quantities, our Christmas cupcakes are available individually at our Highpoint store. For location information, please <a href=\"https://cupcakecentral.com.au/pages/locations\">click here</a>."
          }
        },
        "faq_entry_jAX6L8": {
          "type": "faq_entry",
          "settings": {
            "title_id": "delivery",
            "title": "I have another question!",
            "answer": "You can view all our FAQs by <a href=\"https://cupcakecentral.com.au/pages/faqs\">clicking here</a>, or you can contact our customer service team by calling 9077 4542 or emailing service@cupcakecentral.com.au.Please note than our customer service hours are between 9am and 4pm Monday to Friday, and 9am to 1pm on Saturdays. If you'd like to contact us outside of these hours, please send us an email and we'll get back to you as soon as we can!"
          }
        }
      },
