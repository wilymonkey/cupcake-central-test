          "settings": {
            "title": "When's the earliest I can receive my Easter order?",
            "answer": "All our desserts are made by hand in our Melbourne kitchen, so you'll need to order by 12pm the day before your desired delivery date so we can get everything ready in time for you. If you need something sooner, consider our <a href=\"https://cupcakecentral.com.au/collections/cupcake-gift-boxes\" target=\"_blank\" title=\"https://cupcakecentral.com.au/collections/cupcake-gift-boxes\">classic cupcake gift boxes</a> or <a href=\"https://cupcakecentral.com.au/collections/mini-cupcake-gift-boxes\" target=\"_blank\" title=\"https://cupcakecentral.com.au/collections/mini-cupcake-gift-boxes\">mini cupcake gift boxes</a> instead, which are available for same day delivery as long as you order by 12pm (subject to availability)."
          }
        },
        "faq_entry_i3W4Pa": {
          "type": "faq_entry",
          "settings": {
            "title": "When & where to you deliver to?",
            "answer": "We deliver 7 days a week to most suburbs in Metro Melbourne. To check if your suburb falls within our delivery zone, <a href=\"https://cupcakecentral.com.au/pages/delivery-information\" target=\"_blank\" title=\"https://cupcakecentral.com.au/pages/delivery-information\">click here</a>."
          }
        },
        "faq_entry_k6cU3x": {
          "type": "faq_entry",
          "settings": {
            "title": "How much will delivery cost?",
            "answer": "We offer free delivery any day of the week with orders over $40, including on public holidays. If your order value is below $40, then there is a flat rate delivery fee of $10. We also offer free click and collect from our Highpoint store and West Footscray office locations."
          }
        },
        "faq_entry_T4WQDp": {
          "type": "faq_entry",
          "settings": {
            "title": "Will you be delivering on public holidays?",
            "answer": "Yes, we'll be delivering every day from Monday April 14th to Easter Sunday on April 20th."
          }
        },
        "faq_entry_EPUB4L": {
          "type": "faq_entry",
          "settings": {
            "title": "Will your Highpoint store be open on public holidays?",
            "answer": "Our Highpoint store will be closed on the Good Friday public holiday, and will be open on Easter Saturday and Easter Sunday."
