<script>

 document.addEventListener('DOMContentLoaded', function () {
  const veganProductItems = document.querySelectorAll('.vegan-product-item');
  const veganCollections = document.querySelectorAll('.vegan-products-collection');

  veganProductItems.forEach(item => {
    item.addEventListener('click', function () {
      // Remove 'active-item' class from all items
      veganProductItems.forEach(i => i.classList.remove('active-item'));

      // Add 'active-item' class to the clicked item
      this.classList.add('active-item');

      const tags = this.getAttribute('data-tags').split(',');

      // Hide all collections
      veganCollections.forEach(collection => {
        collection.style.display = 'none';
      });

      // Show collections that match the clicked tag
      tags.forEach(tag => {
        const collection = document.querySelector(`.vegan-products-collection[data-tag="${tag.trim()}"]`);
        if (collection) {
          collection.style.display = 'block';
        }
      });
    });
  });
});


</script>

{% schema %}
{
  "name": "Vegan Landing Page",
  "tag": "section",
  "class": "section",
  "settings": [],
  "blocks": [
   {
     "type": "image",
     "name": "Vegan Types",
     "settings": [
       {
         "type": "image_picker",
         "id": "image",
         "label": "Image",
         "info":"Size : 50px X 50px"
       },
       {
         "type": "text",
         "id": "title",
         "label": "Title",
         "default": "item title"
       },
       {
         "type": "url",
         "id": "link",
         "label": "Link"
       }
     ]
   },
   {
      "type": "vegan_options",
      "name": "vegan Options",
      "limit": 20,
      "settings": [
      {
      "type": "text",
      "id": "vegan_title",
      "label": "Vegan Option",
      "default": "Morning Tea"
    },
    {
      "type": "image_picker",
      "id": "vegan_image",
      "label": "Vegan Option Image",
    },
        {
      "type": "text",
      "id": "vegan_tags",
      "label": "Vegan Tags",
      "default": "cupcake"
    }
      ]
    }
 ],
  "presets": [
  {
    "name": "Vegan Landing"
    }
  ],

}
{% endschema %}
