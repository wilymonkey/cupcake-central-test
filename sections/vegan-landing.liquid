{{ 'vegan-landing.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

<h2 class="vegan-heading">OUR FLAVOURS</h2>
<div class="vegan-flavour-container">
  {% if section.blocks.size > 0 %}
    {% for block in section.blocks %}
      {% if block.type == 'image' %}
        <div class="vegan-flavour-item">
          {% if block.settings.image != blank %}
            <div class="vegan-image">
              <img
                class="lazyload"
                src="{{ block.settings.image | img_url: 'master' }}"
                alt="service Image"
                width="100%"
                height="100%"
              >
            </div>
          {% endif %}
          <div class="vegan-title-block">
            <div class="vegan-title">{{ block.settings.title | escape }}</div>
            <div class="vegan-tags" style="display: none;">{{ block.settings.vegan_tags | escape }}</div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  {% endif %}
</div>

{% if section.blocks.size > 0 %}
  <div class="vegan-products-container">
    {% for block in section.blocks %}
      {% if block.type == 'vegan_options' %}
        <div
          class="vegan-product-item"
          data-tags="{{ block.settings.vegan_tags }}"
          style="background-image: url(https://cdn.shopify.com/s/files/1/1848/3097/{{ block.settings.vegan_image }}); cursor: pointer;"
        >
          <div class="vegan-product-overlay"></div>
          <div class="vegan-product-title">{{ block.settings.vegan_title }}</div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
{% endif %}

<div class="vegan-products-container-collection-container">
  {% assign all_tags = '' %}
  {% for block in section.blocks %}
    {% if block.type == 'vegan_options' %}
      {% assign tags = block.settings.vegan_tags | split: ',' %}
      {% for tag in tags %}
        {% assign all_tags = all_tags | append: tag | append: ',' %}
      {% endfor %}
    {% endif %}
  {% endfor %}

  {% assign all_tags = all_tags | split: ',' | uniq %}

  {% for tag in all_tags %}
    <div class="vegan-products-collection" data-tag="{{ tag }}" style="display: block;">
      <h3 class="vegan-products-collection-header">
        {% if tag == 'gift-box' %}
          VEGAN GIFT BOXES
        {% elsif tag == 'cupcake' %}
          VEGAN CUPCAKES
        {% elsif tag == 'mini-cupcakes' %}
          VEGAN MINI CUPCAKES
        {% elsif tag == 'cake-range' %}
          VEGAN CAKES
        {% elsif tag == 'custom' %}
          CUSTOM
        {% endif %}
      </h3>
      <div id="vegan-products-list-{{ tag | handle }}" class="vegan-products-collection-container">
        {% assign collection_handle = tag | handle %}
        {% assign collection = collections[collection_handle] %}
        {% if collection and collection.products.size > 0 %}
          {% for product in collection.products %}
            {% if tag == 'cupcake' or tag == 'mini-cupcakes' %}
              {% if product.title contains '(V)' %}
                <div class="vegan1-product-item">
                  <a href="{{ product.url }}">
                    <div class="vegan1-product">
                      <div class="vegan1-product-image">
                        {{ product.featured_image | img_url: '350x350' | img_tag: product.featured_image.alt }}
                      </div>
                      <div class="vegan1-title">{{ product.title }}</div>
                      <div class="priceandbutton">
                        <div class="vegan1-price">{{ product.price | money }}</div>
                          <div class="quick-add no-js-hidden">
                          {%-liquid 
                            assign section_id = section.id   
                          %}
                          {%- liquid
                            assign product_form_id = 'quick-add-' | append: section_id | append: product.id
                            assign qty_rules = false
                            if product.selected_or_first_available_variant.quantity_rule.min > 1 or product.selected_or_first_available_variant.quantity_rule.max != null or product.selected_or_first_available_variant.quantity_rule.increment > 1
                              assign qty_rules = true
                            endif
                          -%}
                          {%- if product.variants.size > 1 or qty_rules -%}
                            <a style="text-decoration: none;" href="{{ product.url }}"
                              ><button class="quick-add__submit button button--full-width button--secondary">
                                ORDER NOW
                              </button></a
                            >
                          {%- else -%}
                            {%- if product.tags contains 'Custom' -%}
                              <a style="text-decoration: none;" href="{{ product.url }}"
                                ><button class="quick-add__submit button button--full-width button--secondary">
                                  ORDER NOW
                                </button></a
                              >
                            {%- else -%}
                              <product-form data-section-id="{{ section.id }}">
                                {%- form 'product',
                                  product,
                                  id: product_form_id,
                                  class: 'form',
                                  novalidate: 'novalidate',
                                  data-type: 'add-to-cart-form'
                                -%}
                                  <input
                                    type="hidden"
                                    name="id"
                                    value="{{ product.selected_or_first_available_variant.id }}"
                                    class="product-variant-id"
                                    {% if product.selected_or_first_available_variant.available == false %}
                                      disabled
                                    {% endif %}
                                  >
                                  <button
                                    id="{{ product_form_id }}-submit"
                                    type="submit"
                                    name="add"
                                    class="quick-add__submit button button--full-width button--secondary"
                                    aria-haspopup="dialog"
                                    aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ product.id }}"
                                    aria-live="polite"
                                    data-sold-out-message="true"
                                    {% if product.selected_or_first_available_variant.available == false %}
                                      disabled
                                    {% endif %}
                                  >
                                    <span>
                                      {%- if product.selected_or_first_available_variant.available -%}
                                        {{ 'products.product.add_to_cart' | t }}
                                      {%- else -%}
                                        {{ 'products.product.sold_out' | t }}
                                      {%- endif -%}
                                    </span>
                                    <span class="sold-out-message hidden">
                                      {{ 'products.product.sold_out' | t }}
                                    </span>
                                    {%- render 'loading-spinner' -%}
                                  </button>
                                {%- endform -%}
                              </product-form>
                            {%- endif -%}
                          {%- endif -%}
                        </div>
                      </div>
                    </div>
                  </a>
