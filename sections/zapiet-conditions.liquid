            //Custom time slot for same day delivery
function handleSlotLogic() {
    const now = new Date();
    const hour = now.getHours();

    const morningSlot = "9:00 AM";
    const afternoonSlot = "12:00 PM";

    const enteredPostcode = $('#deliveryGeoSearchField').val()?.trim();
    const normalizedPostcode = String(enteredPostcode).trim();

    {% comment %} const restrictedPostcodes = "3023,3026,3027,3028,3029,3038,3149,3150,3161,3162,3168,3169,3170,3171,3172,3173,3174,3175,3177,3802,3188,3190,3191,3192,3193,3194,3195,3196,3202,3800,3803,3804,3805,3806,3975,3976"
        .split(",")
        .map(pc => pc.trim()); {% endcomment %}
    const rawRestrictedPostcodes = `{{ section.settings.restricted_postcodes | escape }}`;
    const restrictedPostcodes = rawRestrictedPostcodes
        .split(",")
        .map(pc => pc.trim())
        .filter(pc => pc.length > 0);

    // Clear any existing logic
    $(".picker__list-item").hide().removeClass("is-selected");
    $(".picker__day--today").removeClass("picker__day--disabled");
    //put dates as a condition aswell
    if (hour < 9) {
        // Show only morning slot
        $(`.picker__list-item[aria-label='${morningSlot}']`).show().addClass("is-selected");

        // Re-hide afternoon slot in case Zapiet re-rendered it
        // $(".picker__day").on('click',function(){
        //  $(`.picker__list-item[aria-label='${afternoonSlot}']`).hide();
        // console.log(" Re-hid afternoon slot");
        // }
        setTimeout(() => {
            $(`.picker__list-item[aria-label='${afternoonSlot}']`).hide();
            console.log("Re-hid afternoon slot");
        }, 3000); //3 sec timeout set because timeslot panel take atleat 3 sec to render component

    } else if (hour >= 9 && hour < 12) {
        if (restrictedPostcodes.includes(normalizedPostcode)) {
            $(".picker__day--today").addClass("picker__day--disabled");
            console.log("Restricted postcode: disabling today");
        } else {
            $(`.picker__list-item[aria-label='${afternoonSlot}']`).show().addClass("is-selected");
            console.log("Allowed postcode: showing 12:00 PM slot");
        }

    } else {
        $(".picker__day--today").addClass("picker__day--disabled");
        console.log("After 12pm: disabling today");
    }
}

// Run once when picker opens
