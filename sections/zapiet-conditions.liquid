                      if (parseInt($(this).attr("data-pick")) < dateRange[0] || parseInt($(this).attr("data-pick")) > dateRange[1]){
                        $(this).addClass('picker__day--disabled');
                      }
                    });
                  });
                  {% endcomment %}
                  
                {% elsif block.settings.date_options == "specific_dates_option" %}
                    $(".picker__day").addClass('picker__day--disabled');
                  specificDates.forEach(function(specificDate){
                    $(".picker__day").filter(function() {
                      if (parseInt($(this).attr("data-pick")) == specificDate){
                        $(this).removeClass('picker__day--disabled');
                      }
                    });
                  });
                {% endif %}
              {% endif %}

            // Addded this 06/09/2024 - Pratick, to automatically stop weekend order after Friday 12pm

             {% if block.settings.cutoff_fridaytosunday == true %}
              $(document).ready(function() {
                  const currentDate = new Date();
                  const currentDay = currentDate.getDay();  // 6 for Saturday
                  const currentHour = currentDate.getHours();  // 12 pm = 12
              
                  console.log("Current Day:", currentDay);
                  console.log("Current Hour:", currentHour);
                  
                  // Calculate the upcoming Saturday and Sunday
                  const upcomingSaturday = new Date(currentDate);
                  const upcomingSunday = new Date(currentDate);
                  //const upcomingFriday = new Date(currentDate);
                  
                  // Set the dates to the upcoming Saturday and Sunday
                  //upcomingFriday.setDate(currentDate.getDate() + (5 - currentDay));
                  upcomingSaturday.setDate(currentDate.getDate() + (6 - currentDay));
                  upcomingSunday.setDate(currentDate.getDate() + (7 - currentDay));

                  
                  $(".picker__day").filter(function() {
                      const date = convertToDate($(this).attr("aria-label"));
                      
                      console.log("Checking date:", date);
                      
                      // Check if today is Saturday
                      if (currentDay === 6  || currentDay === 7) {
                          // Disable the upcoming Saturday and Sunday
                          if (date.toDateString() === upcomingSaturday.toDateString() || date.toDateString() === upcomingSunday.toDateString()) {
                              $(this).addClass('picker__day--disabled');
                              console.log("Disabling:", date.toDateString());
                          }
                      } 
                      else {
                          // Check if today is Friday and after 12 pm
                          if (currentDay === 5 && currentHour >= 12) {
                              // Disable only the upcoming Saturday and Sunday
                              if (date.toDateString() === upcomingSaturday.toDateString() || date.toDateString() === upcomingSunday.toDateString()) {
                                  $(this).addClass('picker__day--disabled');
                                  console.log("Disabling:", date.toDateString());
                              }
                              else {
                                console.log("Disable for monday");
                              }
                          } 
                          else {
                            console.log("Nothing to disable");
                          }
                      }
                  });
                  });
                  {% endif %}
            }        
          {% endfor %}
        {% endif %} 
    
        // Sat and Sun Text Color and Background Color
        $('.picker__day').each(function(i, day) {
          if (!$(day).hasClass('picker__day--disabled')){
            $(day).css('color', 'black');
          }
          if ($(day).attr('aria-label').includes('Sat') || $(day).attr('aria-label').includes('Sun')){
            if (!$(day).hasClass('picker__day--disabled')){
              $(day).css('color', `{{ section.settings.weekend_text_color }}`);
              $(day).css('background-color', `{{ section.settings.weekend_background_color }}`);
            }
          }
        });
        const currentDatetime = new Date();
        // Enable or Disable Same Day Delivery
        {% if section.settings.enable_same_day_delivery %}
            // Disable Same Day Delivery if Postcode Entered Not In Postcode Settings
            var sameDayPostcodes = [{{ section.settings.same_day_delivery_postcode }}];
            //Comment by shikhar on 14-09-2023
            // if (!sameDayPostcodes.includes(parseInt($('#deliveryGeoSearchField').val()))){
            //     $(".picker__day--today").addClass('picker__day--disabled');
            // }
    
            // Disable Same Day Morning Delivery After 6am	
            // $(".picker__day").on('click',function(){	
            //   if ($(this).hasClass("picker__day--today")) {	
            //     window.ZapietEvent.listen('delivery.timepicker.opened', function() {	
            //       var sameDaySixAM = $(".picker__day--today").data("pick") + (6 * 60 * 60 * 1000);
            //       if (currentDatetime.getTime() > sameDaySixAM) {	
            //         $(`.picker__list-item[aria-label='9:00 AM']`).hide();	
            //       }	
            //     });	
            //   } else {	
            //     window.ZapietEvent.listen('delivery.timepicker.opened', function() {	
            //       //$(`.picker__list-item[aria-label='9:00 AM']`).show();
            //       $(`.picker__list-item[aria-label='9:00 AM']`).hide();
            //     });	
            //   };	
            // });
    
            // Disable Same Day Delivery After 12pm
            // window.ZapietEvent.listen('delivery.datepicker.opened', function() {
            //   {% comment %}
            //   //Pratik changes 10th July, 2024 START
            //   function convertDateToMillisec(dateStr) {
            //         const date = new Date(dateStr);
            //         if (isNaN(date.getTime())) {
            //             throw new Error("Invalid date format");
            //         }
            //         return date.getTime();
            //     }
    
            //   {% if block.settings.half_day_preparation or block.settings.six_hour_preparation or block.settings.nine_hour_preparation or block.settings.one_day_preparation or block.settings.two_days_preparation  %}
            //     $(".picker__day").filter(function() {
            //       const millisec = convertDateToMillisec($(this).attr("aria-label"));
            //       if ( millisec < prepareDate){
            //         $(this).addClass('picker__day--disabled');
            //       }
            //     });
            //   {% endif %}
            //   // END
            //   {% endcomment %}
            //   var sameDayNineAM = $(".picker__day--today").data("pick") + (12 * 60 * 60 * 1000);
            //   if (currentDatetime.getTime() > sameDayNineAM) {	
            //     $(".picker__day--today").addClass('picker__day--disabled');	
            //   };
            // });
          
      
        {% else %}
            $(".picker__day--today").addClass('picker__day--disabled'); // Disable Same Day Delivery
        {% endif %} 
        
        // Today Text Color and Backgroud Color
        if (!$(".picker__day--today").hasClass('picker__day--disabled')){
          $(".picker__day--today").css('color', `{{ section.settings.same_day_text_color }}`);
          $(".picker__day--today").css('background-color',`{{ section.settings.same_day_background_color }}`);     
        }
       
      });
    });
</script>

