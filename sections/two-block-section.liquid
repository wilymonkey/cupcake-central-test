{{ 'section-two-block.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class=" section-{{ section.id }}-padding two-block-section" style="margin: {{ section.settings.blocks_margin }};">
  {% for block in section.blocks %}
    <div
      class="block-content"
      style="background-color: {{ block.settings.background_color }}; border-color: {{ block.settings.block_border_color }};"
    >
      {% if block.settings.image != blank %}
        <img
          src="{{ block.settings.image | img_url: '1024x' }}"
          alt="{{ block.settings.heading | escape }}"
          class="block-image"
        >
      {% endif %}

      <div class="text-content" style="color: {{ block.settings.text_color }};">
        <h2 class="two-block-heading" style="color: {{ block.settings.heading_color }};">
          {{ block.settings.heading }}
        </h2>
        <p>{{ block.settings.caption }}</p>
        <a
          href="{{ block.settings.button_url }}"
          class="two-block-button"
          style="background-color: {{ block.settings.button_color }}; color: {{ block.settings.button_text_color }}; border-radius: {{ block.settings.button_border_radius }}px; border-color: {{ block.settings.button_border_color }};"
        >
          {{- block.settings.button_text -}}
        </a>
      </div>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Two Block Section",
  "class": "custom-two-block-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "range",
      "id": "blocks_margin",
      "label": "Margin between blocks",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "block",
      "name": "Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background Color",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "block_border_color",
          "label": "Block Border Color",
          "default": "#dddddd"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Your Heading Here"
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Heading Color",
          "default": "#000000"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "Your caption here"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text Color",
          "default": "#000000"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Click Me"
        },
        {
          "type": "color",
          "id": "button_color",
          "label": "Button Background Color",
          "default": "#0000ff"
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "Button Text Color",
          "default": "#ffffff"
        },
        {
          "type": "number",
          "id": "button_border_radius",
          "label": "Button Border Radius (px)",
          "default": 5
        },
        {
          "type": "color",
          "id": "button_border_color",
          "label": "Button Border Color",
          "default": "#333333"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Two Block Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}
