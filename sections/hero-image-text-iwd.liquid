      </div>
    </div>
  {% endif %}
</div>

<div
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }} page-width flex-centered ws-delivery-block ws-delivery-block-mobile"
  style="background-color: {{ section.settings.bg_color }}"
>
  <div id="ws-delivery-block-inner-right">
    <div class="ws-delivery-block-img-container fit-to-parent">
      <img
        id="ws-delivery-block-img"
        class="lazyload fit-image-to-parent"
        alt="postcode-checker-image"
        loading="lazy"
        src="{{section.settings.desktop_image | img_url: 'master'}}"
      >
    </div>
  </div>
  <div id="ws-delivery-block-inner-left">
    <div id="ws-delivery-block-right-content" class="fit-to-parent">
      <div id="ws-delivery-block-right-content-text">
        <h1 class="uppercase" style="color: {{ section.settings.title_color }}">
          {{ section.settings['title-line1'] }} 
        </h1>
        <h1 class="uppercase" style="color: #1b9a8e;">{{ section.settings['title-line2'] }}</h1>
        <h1 class="uppercase" style="color: #1b9a8e;">{{ section.settings['title-line3'] }}</h1>
        <p style="color: {{ section.settings.description_color }}">
          {{ section.settings['paragraph-description'] }}
        </p>
      </div>
      <div id="ws-delivery-block-input" class="">
        {% if section.settings['is-button-scroll-to-section'] == false -%}
          <a href="{{ section.settings.link }}">
        {%- endif %}
        <button
          type="submit"
          class="order-button-iwd"
          data-target="ordernow-block-iwd"
          {% if section.settings['is-button-scroll-to-section'] == true %}
            onclick="document.getElementById('{{ section.settings.scroll-to-section-id }}').scrollIntoView();"
          {% endif %}
        >
          {{ section.settings['button-text'] }}
        </button>
        {% if section.settings['is-button-scroll-to-section'] == false %}</a>{% endif %}
      </div>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('.order-button-iwd, .smooth-scroll-button').forEach(button => {
    button.addEventListener('click', function (e) {
      e.preventDefault();
      const targetId = this.getAttribute('data-target');
      const targetSection = document.getElementById(targetId);

      if (targetSection) {
        const offsetTop = targetSection.getBoundingClientRect().top + window.scrollY - 220; // Adjust -220 if needed
        window.scrollTo({ top: offsetTop, behavior: 'smooth' });
      }
    });
  });

document.addEventListener("DOMContentLoaded", function () {
    const numberElement = document.getElementById("animated-number");
    const targetNumber = parseInt(numberElement.getAttribute("data-target"), 10);
    
    let currentNumber = 0;
    const duration = 4000; // Slow animation (4 seconds)
    const interval = 50; // Update interval (50ms)
    const step = targetNumber / (duration / interval);

    function updateNumber() {
      currentNumber += step;
      if (currentNumber >= targetNumber) {
        numberElement.textContent = targetNumber; // Ensure exact final value
        numberElement.classList.add("slam-effect"); // Add slam effect
      } else {
        numberElement.textContent = Math.floor(currentNumber);
        requestAnimationFrame(updateNumber);
      }
    }

    // Intersection Observer to trigger animation on scroll
    const observer = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            updateNumber();
            observer.unobserve(numberElement); // Stop observing once started
          }
        });
      },
      { threshold: 0.5 } // Trigger when 50% of the element is visible
    );

    observer.observe(numberElement);
  });
</script>

<style>
  @keyframes slam {
    0% { transform: scale(1); }
    50% { transform: scale(1.3); }
    100% { transform: scale(1); }
  }

  .slam-effect {
    animation: slam 0.3s ease-out;
  }
</style>

{% schema %}
 {
   "name": "Hero Image & Text IWD",
   "tag": "section",
   "class": "hero-image-and-text",
   "settings": [
     {
         "type": "color_scheme",
         "id": "color_scheme",
         "label": "t:sections.all.colors.label",
         "info": "t:sections.all.colors.has_cards_info",
         "default": "scheme-1"
     },
     {
       "type": "color",
       "id": "bg_color",
       "label": "Background Color",
       "default": "#FFFFFF"
     },
     {
       "type": "color",
       "id": "title_color",
       "label": "Title Color",
       "default": "#000000"
     },
     {
       "type": "color",
       "id": "description_color",
       "label": "Description Color",
       "default": "#000000"
     },
     {
       "type": "select",
       "id": "image_position",
       "label": "Image Position",
       "default": "left",
       "options": [
         { "value": "left", "label": "Left"},
         { "value": "right", "label": "Right"}
       ]
     },
     {
       "type": "image_picker",
       "id": "desktop_image",
       "label": "Desktop Image"
     },
     {
       "type": "image_picker",
       "id": "mobile_image",
       "label": "Mobile Image"
     },
     {
       "type": "text",
       "id": "title-line1",
       "label": "Title Line 1"
     },
     {
       "type": "text",
       "id": "title-line2",
       "label": "Title Line 2"
     },
     {
       "type": "text",
       "id": "title-line3",
       "label": "Title Line 3"
     },
     {
       "type": "text",
       "id": "paragraph-description",
       "label": "Description"
     },
     {
       "type": "text",
       "id": "button-text",
       "label": "Button Text"
     },
     {
       "type": "url",
       "id": "link",
       "label": "Link"
     },
     {
       "type": "checkbox",
       "id": "is-button-scroll-to-section",
       "label": "Button scrolls to section",
       "default": false
     },
     {
       "type": "text",
       "id": "scroll-to-section-id",
       "label": "Scroll to section ID"
     }
],
"presets": [
     {
       "name": "Hero Image & Text - IWD"
     }
   ]
 }
{% endschema %}
