<style>
.partner-title {
  font-size: 4rem;
  color: #686868;
  font-weight: bold;
  text-transform: uppercase;
  text-align: center;
}

.partner-block {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  overflow: hidden;
  width: 100%;
  background-color: #fcf8f3;
}

.partner-items-container {
  display: flex;
  gap: 40px;
  animation: scroll-left 20s linear infinite;
  will-change: transform; /* Optimize animation */
  background-color: #fcf8f3;
}

.partner-item {
  aspect-ratio: 1 / 1;
  overflow: hidden;
  display: flex;
  justify-content: center;
  align-items: center;
  min-width: 15%;
}

.partner-item a {
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.partner-img {
  height: 80%;
  object-fit: contain;
  width: 100%;
}

@keyframes scroll-left {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%); /* Adjust to match half the container width for a seamless loop */
  }
}

.partner-items-container:after {
  content: '';
  display: none;
}

@media screen and (min-width: 750px) {
  .partner-block {
    flex-direction: row;
  }

  .partner-item {
    width: 7%;
  }
}

@media screen and (max-width: 750px) {
  .partner-block {
    flex-direction: column;
    justify-content: center;
    text-align: center;
  }
.partner-items-container {
  display: flex;
  gap: 60px;
  animation: scroll-left 20s linear infinite;
  will-change: transform; /* Optimize animation */
  background-color: #fcf8f3;
}
  
}
</style>

{% if section.settings.header_title != blank %}
  <div class="collection__title">
    <h2 class="partner-title related-products__heading inline-richtext">
      {{ section.settings.header_title }}
    </h2>
  </div>
{% endif %}

<div class="section-{{ section.id }}-padding">
  {% if section.blocks.size > 0 %}
    <div class="partner-block">
      <div class="partner-items-container">
        {% for block in section.blocks %}
          <div class="partner-item">
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}">
            {% endif %}
            <img
              src="{{ block.settings.desktop_image | img_url: 'master' }}"
              class="partner-img"
              alt="Partner Image"
            >
            {% if block.settings.link != blank %}
              </a>
            {% endif %}
          </div>
        {% endfor %}
        {% for block in section.blocks %}
          <div class="partner-item"> <!-- Duplicate items for seamless scrolling -->
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}">
            {% endif %}
            <img
              src="{{ block.settings.desktop_image | img_url: 'master' }}"
              class="partner-img"
              alt="Partner Image"
            >
            {% if block.settings.link != blank %}
              </a>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  {% else %}
    <p>No partners added yet.</p>
  {% endif %}
</div>

{% schema %}
{
  "name": "Partners",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "header_title",
      "label": "Header Title",
      "default": "Our Partners"
    }
  ],
  "blocks": [
    {
      "type": "partner-block",
      "name": "Partner Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Partners",
      "blocks": [
        { "type": "partner-block" },
        { "type": "partner-block" },
        { "type": "partner-block" }
      ]
    }
  ]
}
{% endschema %}
