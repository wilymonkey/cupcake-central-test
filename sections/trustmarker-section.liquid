{%- comment -%}
  This section file contains the settings and passes them to the snippet.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- render 'trustmarker-snippet',
  blocks: section.blocks,
  background_color: section.settings.background_color,
  section_id: section.id
-%}

{% schema %}
{
  "name": "Trustmarker Section",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#26A69A"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "trust_marker",
      "name": "Trust Marker",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "heart", "label": "Heart" },
            { "value": "smile", "label": "Smile" },
            { "value": "cake", "label": "Cake" },
            { "value": "star", "label": "Star" }
          ],
          "default": "heart"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "BAKED FRESH"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Daily from our kitchen"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trustmarker Section",
      "blocks": [
        { "type": "trust_marker", "settings": { "icon": "heart", "title": "BAKED FRESH", "subtitle": "Daily from our kitchen" }},
        { "type": "trust_marker", "settings": { "icon": "smile", "title": "200K+ ORDERS", "subtitle": "Cupcakes baked each year" }},
        { "type": "trust_marker", "settings": { "icon": "cake", "title": "1 MILLION+", "subtitle": "Cupcakes baked each year" }},
        { "type": "trust_marker", "settings": { "icon": "star", "title": "4.9 STAR", "subtitle": "Google rating by the public" }}
      ]
    }
  ]
}
{% endschema %}