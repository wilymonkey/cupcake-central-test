<style>
  .contact-information-block {
    position: relative;
    border-radius: 10px;
    margin-top: 2rem;
    margin-bottom: 2rem;
    display: flex;
    background-color: {{ section.settings.bg_color }};
    color: #fff;
  }
  
  #contact-information-block-inner-left {
      width: 40%;
      padding: 7rem 2rem;
  }
  
  .contact-information-block-inner-right {
      width: 60%;
      padding: 7rem;
      background-color: {{ section.settings.right_bg_color }};
      border-radius: 15px;
      margin: 1.5rem 0;
  }
  
  #contact-information-block-left-content {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
  }
  
  #contact-information-block-left-content h1 {
      color:white;
      margin: 0;
      padding: 0;
      font: normal normal 800 64px/95px Poppins;
      font-size: calc(100vw * (50/1920));
      line-height: 1;
      letter-spacing: 0px;
  }
  
  #contact-information-block-left-content h2 {
      color:white;
      margin: 0;
      padding: 0;
      font: normal normal normal 100px/100px Tenstars;
      font-size: calc(100vw * (60/1920));
      line-height: calc(100vw * (90/1920));
      letter-spacing: 0px;
      color: #F283B4;
      margin-top: calc(100vw * ( -13 / 1920));
  }
  
  #contact-information-block-left-content p {
      color:white;
      margin: 2rem 0;
      padding: 0;
      font: normal normal normal 24px/35px Poppins;
      font-size: calc(100vw * (14/1920));
      line-height: calc(100vw * (25/1920));
      letter-spacing: 0px;
      padding-top: 1rem;
  }

  #contact-information-block-right-content h1 {
      color:white;
      margin: 0;
      padding: 0;
      font: normal normal 800 64px/95px Poppins;
      font-size: calc(100vw * (50/1920));
      line-height: 1;
      letter-spacing: 0px;
  }
  
  #contact-information-block-right-content p {
      color:white;
      margin: 2rem 0;
      padding: 0;
      font: normal normal normal 24px/35px Poppins;
      font-size: calc(100vw * (14/1920));
      line-height: calc(100vw * (25/1920));
      letter-spacing: 0px;
      padding-top: 1rem;
  }
  
  #contact-information-block-input {
      gap: 16px;
      height: calc(100vw * (60/1920));
      display: flex;
      justify-content: flex-start;
      align-items: center;
      margin-top: 1rem;
  }
  
  #contact-information-block-input form input {
      height: 100%;
      background: #F0F0F0 0% 0% no-repeat padding-box;
      border: 1px solid #686868;
      border-radius: 5px;
      width: calc(100vw * (360/1920));
      padding: 0 23px;
      font: normal normal normal 18px/27px Poppins;
      font-size: calc(100vw * (18/1920));
      line-height: calc(100vw * (27/1920));
  }
  
  #contact-information-block-input button {
      height: 100%;
      width: calc(100vw * (180/1920));
      font: normal normal bold 18px/27px Poppins;
      font-size: calc(100vw * (18/1920));
      font-weight: bold;
      line-height: calc(100vw * (27/1920));
      letter-spacing: 0px;
      background-color: #fff;
      color: #686868;
      border: none;
      border-radius: 5px;
  }
#contact-information-block-right-content input[type="email"] {
    border-radius: 3px;
    height: 4rem;
    width: 49.6%;
    margin: 1rem 0;
    padding: 1rem;
    border: none;
}
  #contact-information-block-right-content input[type="tel"] {
    border-radius: 3px;
    height: 4rem;
    width: 49.6%;
    margin: 1rem 0;
    padding: 1rem;
    border: none;
}
  .contact-information-block-content {
    display: flex;
    align-items: center;
    margin-bottom: 4rem;
  }

  .delivery-image {
    width: 4rem;
    height: 4rem;
    margin-right: 4rem;
  }

  .contact-item-block {
    display: flex;
    justify-content: center;
    margin: 0 auto;
  }

  .contact-sub-item {
    width: 100%;
    margin: 2rem;
    text-align: center;
  }

  .contact-sub-content {
    font-size: 2rem;
    font-weight: bold;
    color: #686868;
    margin: -1rem 0;
  }

  .sub-image {
    width: 60px;
    height: 60px;
  }

  #contact-information-block-right-content input[type="text"] {
    border-radius: 3px;
    height: 4rem;
    width: 49.6%;
    margin: 1rem 0;
    padding: 1rem;
    border: none;
  }

  #contact-information-block-right-content input[type="checkbox"] {
    width: 20px;
    height: 20px;
    margin-right: 1rem;
  }

  .selection-block {
    background-color: #fff;
    border-radius: 5px;
    margin-bottom: 2rem;
    padding: 2rem;
    display: flex;
    justify-content: space-around;
  }

  .selection-block-item {
    color: #000;
    display: flex;
    align-items: center;
  }

  .contact-information-btn button {
      width: calc(100vw * (180/1920));
      aspect-ratio: 3/1;
      font: normal normal bold 18px/27px Poppins;
      font-size: calc(100vw * (18/1920));
      font-weight: bold;
      line-height: calc(100vw * (27/1920));
      letter-spacing: 0px;
      background-color: #fff;
      color: #686868;
      border: none;
      border-radius: 5px;
      float: right;
  }
  
  @media (max-width: 850px) {
      .contact-information-block {
        display: block !important;
      }

    #contact-information-block-inner-left {
      width: 100%;
      padding: 2rem;
    }
    
    .contact-information-block-inner-right {
        width: 100%;
        padding: 2rem;
        display: inline-block;
    }

    #contact-information-block-right-content input[type="text"] {
      width: 49.3%;
    }

    #contact-information-block-left-content h1 {
        font-size: 5rem;
    }
    
    #contact-information-block-left-content h2 {
        font-size: 5rem;
    }
    
    #contact-information-block-left-content p {
        font-size: 1.5rem;
        line-height: 100%;
        padding-top: 0.5rem;
    }
  
    #contact-information-block-right-content h1 {
        font-size: 5rem;
    }
    
    #contact-information-block-right-content p {
        font-size: 1.5rem;
        line-height: 100%;
        padding-top: 0.5rem;
    }

    .contact-information-block-content {
      margin-bottom: 2rem;
    }

    .text-input-group {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .contact-information-btn button {
      width: 20%;
      font-size: 1.5rem;
    }
  }

  @media (max-width: 600px) {
     .selection-block {
        display: block;
      }
  }
</style>
<div class="page-width flex-centered contact-information-block">
    <div id="contact-information-block-inner-left">
        <div id="contact-information-block-left-content">
            <h1 class="uppercase">{{ section.settings.title-line1 }}</h1>
