            <p>{{ section.settings.paragraph-description }}</p>
            <div class="contact-information-block-content">
              <img
                class="delivery-image"
                src="{{ section.settings.image1 | img_url: 'master' }}"
                alt="delivery Image"
              >
              <span>
                {{ section.settings.phone }}
              </span>
            </div>
            <div class="contact-information-block-content">
              <img
                class="delivery-image"
                src="{{ section.settings.image2 | img_url: 'master' }}"
                alt="delivery Image"
              >
              <span>
                {{ section.settings.email }}
              </span>
            </div>
            <div class="contact-information-block-content">
              <img
                class="delivery-image"
                src="{{ section.settings.image3 | img_url: 'master' }}"
                alt="delivery Image"
              >
              <span>
                {{ section.settings.address }}
              </span>
            </div>
          <div class="contact-item-block">
            <div class="contact-sub-item">
              <a href="{{ section.settings.sub_link1 }}" style="text-decoration: none;">
                <img src="{{ section.settings.sub_image1 | img_url: 'master'  }}" class="sub-image"/>
                <div class="contact-sub-content">
                    <p class="uppercase">{{ section.settings.sub-title1 }}</p>
                </div>
              </a>
            </div>
            <div class="contact-sub-item">
              <a href="{{ section.settings.sub_link2 }}" style="text-decoration: none;">
                <img src="{{ section.settings.sub_image2 | img_url: 'master'  }}" class="sub-image"/>
                <div class="contact-sub-content">
                    <p class="uppercase">{{ section.settings.sub-title2 }}</p>
                </div>
              </a>
            </div>
            <div class="contact-sub-item">
              <a href="{{ section.settings.sub_link3 }}" style="text-decoration: none;">
                <img src="{{ section.settings.sub_image3 | img_url: 'master'  }}" class="sub-image"/>
                <div class="contact-sub-content">
                    <p class="uppercase">{{ section.settings.sub-title3 }}</p>
                </div>
              </a>
            </div>
            <div class="contact-sub-item">
              <a href="{{ section.settings.sub_link4 }}" style="text-decoration: none;">
                <img src="{{ section.settings.sub_image4 | img_url: 'master'  }}" class="sub-image"/>
                <div class="contact-sub-content">
                    <p class="uppercase">{{ section.settings.sub-title4 }}</p>
                </div>
              </a>
            </div>
        </div>
        </div>
    </div>
