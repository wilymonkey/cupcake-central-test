<style>
  .three-block-section {
    display: flex;
    flex-wrap: wrap;
    width: 100%;
    max-width:var(--page-width);
    margin:auto;
    padding:0 2rem;
    border-radius: 10px;
  }

  .block-content {
      flex-basis: 30%;
      text-align: left;
      margin: 20px auto;
      border-radius: 25px;
      max-width: 750px;
      display: flex;
      align-items: baseline;
      flex-direction: column;
      justify-content: space-between;
  }


  .block-image {
      width: 100%;
      display: block;
      margin-bottom: 10px;
      border-radius: 15px;
      border: 1px solid #707070;
  }

  .three-block-button {
    display: inline-block;
    padding: 10px 20px;
    text-decoration: none;
    border-radius: 5px;
    border: 1px solid;
    margin-top: 10px;
    font-weight:600;
  }

  .three-block-section-img-container {
    aspect-ratio: 1/1;
    width: 100%;
    height: 100%;
  }

  .three-block-section-img-container img {
    aspect-ratio: 1/1;
    object-fit: cover;
    min-width: 100%;
  }

  .three-block-button {
    cursor: pointer;
  }

  @media (max-width: 768px) {
    .block-content {
      flex-basis: 90%;
      margin: 10px auto;
    }
    .block-image{
      height: 25rem;
    }
    .three-block-section{
      padding: 0 0.5rem !important;
    }
  }
  .three-block-heading{
    text-transform: uppercase;
    font-size: 2.8rem;
  }
</style>
<div
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }} three-block-section page-width"
  style="background-color: {{ section.settings.background_color }}; margin: {{ section.settings.blocks_margin }};"
>
  {% for block in section.blocks %}
    <div class="block-content">
      <div class="three-block-section-img-container">
        {% if block.settings.image != blank %}
          <img
            src="{{ block.settings.image | img_url: '1024x' }}"
            alt="{{ block.settings.heading | escape }}"
            class="block-image"
          >
        {% endif %}

        <div class="text-content" style="color: {{ block.settings.text_color }};">
          <h2 class="three-block-heading uppercase" style="color: {{ block.settings.heading_color }};">
            {{ block.settings.heading }}
          </h2>
          <p>{{ block.settings.caption }}</p>
        </div>
      </div>
      <a
        {% if section.settings['is-button-scroll-to-section'] == false -%}
          href="{{ block.settings.button_url }}"
        {% else %}
          href="#{{ block.settings.scroll-to-section-id }}"
        {% endif %}
        class="three-block-button uppercase"
        style="background-color: {{ block.settings.button_color }}; color: {{ block.settings.button_text_color }}; border-radius: {{ block.settings.button_border_radius }}px; border-color: {{ block.settings.button_border_color }};"
      >
        {{- block.settings.button_text -}}
      </a>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Three Block Section",
  "class": "custom-three-block-section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "blocks_margin",
      "label": "Margin between blocks",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "three-section-block",
      "name": "Three Section Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background Color",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "block_border_color",
          "label": "Block Border Color",
          "default": "#dddddd"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Your Heading Here"
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Heading Color",
          "default": "#000000"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "Your caption here"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text Color",
          "default": "#000000"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL"
        },
       {
         "type": "checkbox",
         "id": "is-button-scroll-to-section",
         "label": "Button scrolls to section",
         "default": false
       },
       {
         "type": "text",
         "id": "scroll-to-section-id",
         "label": "Scroll to section ID"
       },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Click Me"
        },
        {
          "type": "color",
          "id": "button_color",
          "label": "Button Background Color",
          "default": "#0000ff"
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "Button Text Color",
          "default": "#ffffff"
        },
        {
          "type": "number",
          "id": "button_border_radius",
          "label": "Button Border Radius (px)",
          "default": 5
        },
        {
          "type": "color",
          "id": "button_border_color",
          "label": "Button Border Color",
          "default": "#333333"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Three Block Section",
      "blocks": [
          {
            "type": "three-section-block"
          },
          {
            "type": "three-section-block"
          },
          {
            "type": "three-section-block"
          }
        ]
    }
  ]
}
{% endschema %}
