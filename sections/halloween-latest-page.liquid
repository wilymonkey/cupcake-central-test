    },
    {
      "type": "text",
      "id": "collection-header",
      "default": "Collection Header",
      "label": "Enter collection header"
    },
    {
      "type": "text",
      "id": "collection-subheader",
      "default": "Collection Sub Header",
      "label": "Enter collection sub header"
    },
    {
      "type": "header",
      "content": "Promo Section"
    },
    {
      "type": "text",
      "id": "promo_header",
      "label": "Promo Header",
      "default": "UNBOX THE UNDEATH"
    },
    {
      "type": "text",
      "id": "promo_subheader",
      "label": "Promo Sub-header",
      "default": "Available to order now! For delivery and instore between Monday 27 October - Sunday 2 November."
    },
    {
      "type": "collection",
      "id": "promo_collection",
      "label": "Promo Collection"
    }
  ],
  "presets": [
    {
      "name": "Halloween Landing"
    }
  ],
  "blocks": [
    {
      "type": "halloween-products",
      "name": "Halloween Products",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "background_image",
          "label": "Product Background Image"
        },
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Product Image"
        },
        {
          "type": "text",
          "id": "halloween_text",
          "label": "Product text",
          "default": "Halloween"
        }
      ]
    }
  ]
}
{% endschema %}
