<div class="promo-container">
    {%- if section.settings.promo_header != blank -%}
      <h2 class="promo-header">{{ section.settings.promo_header }}</h2>
    {%- endif -%}
    {%- if section.settings.promo_subheader != blank -%}
      <p class="promo-subheader">{{ section.settings.promo_subheader }}</p>
    {%- endif -%}

    {%- if section.settings.promo_collection.products.size > 0 -%}
      <div class="promo-products-grid">
        {%- for product in section.settings.promo_collection.products limit: 3 -%}
          <div class="promo-product-card">
            <a href="{{ product.url | within: collection }}" class="promo-product-link">
              {%- if product.featured_image -%}
                <img
                  src="{{ product.featured_image | image_url: width: 400 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  loading="lazy"
                  class="promo-product-image"
                >
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
              <h3 class="promo-product-title">{{ product.title }}</h3>
            </a>
            <div class="promo-product-price">
              {{ product.price | money }}
            </div>
            <a href="{{ product.url | within: collection }}" class="promo-product-button">SHOP NOW</a>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
