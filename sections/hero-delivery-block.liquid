{% schema %}
 {
   "name": "Hero Image & Text",
   "tag": "section",
   "class": "hero-image-and-text",
   "settings": [
     {
         "type": "color_scheme",
         "id": "color_scheme",
         "label": "t:sections.all.colors.label",
         "info": "t:sections.all.colors.has_cards_info",
         "default": "scheme-1"
     },
     {
       "type": "color",
       "id": "bg_color",
       "label": "Background Color",
       "default": "#FFFFFF"
     },
     {
       "type": "color",
       "id": "title_color",
       "label": "Title Color",
       "default": "#000000"
     },
     {
       "type": "color",
       "id": "description_color",
       "label": "Description Color",
       "default": "#000000"
     },
     {
       "type": "select",
       "id": "image_position",
       "label": "Image Position",
       "default": "left",
       "options": [
         { "value": "left", "label": "Left"},
         { "value": "right", "label": "Right"}
       ]
     },
     {
       "type": "image_picker",
       "id": "desktop_image",
       "label": "Desktop Image"
     },
     {
       "type": "image_picker",
       "id": "mobile_image",
       "label": "Mobile Image"
     },
     {
       "type": "text",
       "id": "title-line1",
       "label": "Title Line 1"
     },
     {
       "type": "text",
       "id": "title-line2",
       "label": "Title Line 2"
     },
     {
       "type": "text",
       "id": "title-line3",
       "label": "Title Line 3"
     },
     {
       "type": "text",
       "id": "paragraph-description",
       "label": "Description"
     },
     {
       "type": "text",
       "id": "button-text",
       "label": "Button Text"
     },
     {
       "type": "url",
       "id": "link",
       "label": "Link"
     },
     {
       "type": "checkbox",
       "id": "is-button-scroll-to-section",
       "label": "Button scrolls to section",
       "default": false
     },
     {
       "type": "text",
       "id": "scroll-to-section-id",
       "label": "Scroll to section ID"
     }
],
"presets": [
     {
       "name": "Hero Image & Text"
     }
   ]
 }
{% endschema %}
