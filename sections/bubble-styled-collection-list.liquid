{{ 'component-bubble-collection-list.css' | asset_url | stylesheet_tag }}
<div class="ishiservices">
  <div>
    {% if section.blocks.size > 0 %}
      <div class="ishiservices-content">
        {% for block in section.blocks %}
          <div class="services col-lg-2 col-md-6 col-sm-6 col-xs-12">
            <a
              {% if block.settings.link != blank %}
                href="{{ block.settings.link }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
              class="bubble-link"
            >
              {% if block.settings.image != blank %}
                <div class="service-img">
                  <img
                    class="lazyload"
                    src="{{ block.settings.image | img_url: 'master' }}"
                    alt="service Image"
                    width="50"
                    height="50"
                  >
                </div>
              {% endif %}
              <div class="service-block">
                <div class="title">{{ block.settings.title | escape }}</div>
                <p class="description">{{ block.settings.description | escape }}</p>
              </div>
            </a>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

<style type="text/css">
  #shopify-section-{{ section.id }} {
    margin-bottom: {{ section.settings.section_bottom_spacing_desktop }}px;
  }
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} {
      margin-bottom: {{ section.settings.section_bottom_spacing_mobile }}px;
    }
  }
</style>

{% schema %}
 {
   "name": "Bubble Collections",
     "class": "ishi-service-style1",
   "max_blocks": 6,
   "tag": "section",
   "settings": [
  {
       "type": "header",
       "content": "Section Bottom Spacing"
     },
     {
       "type": "range",
       "id": "section_bottom_spacing_desktop",
       "label": "Desktop",
       "min": 0,
       "max": 70,
       "step": 10,
       "default": 70
     },
     {
       "type": "range",
       "id": "section_bottom_spacing_mobile",
       "label": "Mobile",
       "min": 0,
       "max": 50,
       "step": 10,
       "default": 30
     }
   ],
   "blocks": [
     {
       "type": "image",
       "name": "Collection",
       "settings": [
         {
           "type": "image_picker",
           "id": "image",
           "label": "Image",
           "info":"Size : 50px X 50px"
         },
         {
           "type": "text",
           "id": "title",
           "label": "Title",
           "default": "item title"
         },
         {
           "type": "url",
           "id": "link",
           "label": "Link"
         }
       ]
     }
   ],
"presets": [
     {
       "name": "Bubble Collections",
       "blocks": [
         {
           "type": "image"
         },
         {
           "type": "image"
         },
         {
           "type": "image"
         },
         {
           "type": "image"
         }
       ]
     }
   ]
 }
{% endschema %}
