        line-height: 30px;
        color: #f283b4;
        margin-bottom: 0;
        text-align: center;
      }

      #hf-desktop-block-content-subheading-imageandtext-01 {
        font-family: "TT COMMONS";
        font-weight: 900;
        font-size: 36px;
        line-height: 30px;
        color: #f283b4;
        margin-bottom: 0;
      }

      #hf-form-field-imageandtext-01 {
