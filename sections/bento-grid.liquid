{%- comment -%}
  Render the bento-grid-snippet file.
{%- endcomment -%}
{%- render 'bento-grid-snippet',
  image: section.settings.image,
  heading: section.settings.heading,
  text: section.settings.text,
  button_text: section.settings.button_text,
  button_link: section.settings.button_link,
  text_alignment: section.settings.text_alignment,
  image_position: section.settings.image_position,
  image_orientation: section.settings.image_orientation,
  image_style: section.settings.image_style,
  background_color: section.settings.background_color
-%}

{% schema %}
{
  "name": "Bento Grid",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Header / Title"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>In rhoncus felis sed sodales fermentum. Pellentesque eget odio vitae turpis malesuada feugiat at in risus.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Button XSML"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "radio",
      "id": "image_style",
      "label": "Image Style",
      "options": [
        { "value": "filled", "label": "Filled" },
        { "value": "framed", "label": "Framed" }
      ],
      "default": "framed"
    },
    {
      "type": "radio",
      "id": "image_orientation",
      "label": "Image Orientation",
      "options": [
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "radio",
      "id": "image_position",
      "label": "Image Position (Desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "Bento Grid"
    }
  ]
}
{% endschema %}