{% comment %} {{ 'product-page.css' | asset_url | stylesheet_tag }} {% endcomment %}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
{{ 'component-rating.css' | asset_url | stylesheet_tag }}
{{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
    /* Hide spinner arrows on Chrome, Safari, Edge, Opera */
  input[type=number]::-webkit-inner-spin-button,
  input[type=number]::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  /* Hide spinner arrows on Firefox */
  input[type=number] {
    -moz-appearance: textfield;
  }
  /* When the <details> tag is open, show the .accordion-border inside it */
  details[open] > .accordion-border {
    display: block !important;
  }

  /* When the <details> tag is open, rotate the SVG icon inside the <summary> */
  details[open] > summary svg {
    transform: rotate(180deg);
  }
    details[open] > summary {
    color: #F65B99;
  }
  @media screen and (min-width: 1023px) {
    details[open] {
    border: 2px solid #F65B99;
  }
  details[open] > summary {
    border: none;
  }
  }
{%- endstyle -%}

<section class="section-{{ section.id }}-padding" style="background-color: {{ section.settings.background_color }};">
  <div class="w-full d-sm:max-w-[1340px] d-sm:mx-auto d-lg:max-w-[1840px] d-lg:mx-auto">
    <div
      id="ProductSection-{{ section.id }}"
      class="grid grid-cols-1 md:grid-cols-2! m-0! gap-0! pt-0! md:pt-6!"
    >
      {% comment %}
        COLUMN 1: Product Media Gallery
      {% endcomment %}

      {%- comment -%}
        DESKTOP GALLERY (md and up)
      {%- endcomment -%}
      <div id="product-gallery-{{ section.id }}-desktop" class="product-gallery-wrapper hidden md:block!">
        <div class="rounded-xl bg-parchment p-[24px] d-lg:p-[48px] d-sm:pr-5">
          {%- comment -%}
            Main media container.
            Now supports multiple media types.
          {%- endcomment -%}
          <div class="relative w-[464px] h-[580px] d-sm:w-[576px] d-lg:w-[864px] d-lg:h-[1080px] aspect-[4/5] overflow-hidden bg-gray-200 flex items-center justify-center 2-xl:mx-auto">
            {%- for media in product.media -%}
              <div
                class="product-main-media absolute inset-0 w-full h-full {% unless forloop.first %}hidden{% endunless %}"
                data-media-id="{{ media.id }}"
                data-media-type="{{ media.media_type }}"
                aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
              >
                {%- case media.media_type -%}
                  {%- when 'image' -%}
                    <img
                      src="{{ media | image_url: width: 1200 }}"
                      alt="{{ media.alt | escape }}"
                      class="object-cover w-full h-full"
                      height="{{ media.height }}"
                      width="{{ media.width }}"
                      loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    >
                  {%- when 'external_video' -%}
                    {{
                      media
                      | video_tag:
                        class: 'w-full h-full object-cover',
                        image_size: '1200x',
                        controls: true,
                        autoplay: true
                    }}
                  {%- when 'video' -%}
                    {{
                      media
                      | video_tag:
                        class: 'w-full h-full object-cover',
                        image_size: '1200x',
                        controls: true,
                        autoplay: true
                    }}
                  {%- when 'model' -%}
                    {{
                      media
                      | model_viewer_tag:
                        class: 'w-full h-full',
                        image_size: '1200x',
                        interaction-prompt: 'auto',
                        camera-controls: true,
                        ar: true
                    }}
                {%- endcase -%}
              </div>
            {%- endfor -%}
          </div>

          {%- comment -%} --- CORRECTED THUMBNAIL WRAPPING --- {%- endcomment -%}
          <div class="flex flex-wrap gap-3 d-sm:gap-[10.6px] d-lg:gap-[19.2px] mt-4 d-lg:mt-[22px] md:w-[464px] d-sm:w-[576px] d-lg:w-[870px] justify-start">
            {% for media in product.media %}
              <button
                class="
                  gallery-thumbnail relative flex-shrink-0 aspect-[4/5] overflow-hidden
                  border-2 {% if forloop.first %}border-popsugar{% else %}border-transparent{% endif %}
                  focus:outline-none focus:ring-2 focus:ring-popsugar focus:ring-offset-2 transition-all duration-200
                "
                data-media-id="{{ media.id }}"
                aria-label="{{ media.alt | escape }}"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              >
                <img
                  src="{{ media.preview_image | image_url: width: 250 }}"
                  alt="{{ media.alt | escape }}"
                  class="w-[107px] h-[133px] d-sm:w-[132px] d-sm:h-[165px] d-lg:w-[198px] d-lg:h-[248px] object-cover"
                  height="248"
                  width="198"
                  loading="lazy"
                >
                {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                  <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-8 w-8 text-white"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                    >
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
                    </svg>
                  </div>
                {%- endif -%}
              </button>
            {% endfor %}
          </div>
        </div>
      </div>

      {%- comment -%}
        MOBILE GALLERY (below md)
      {%- endcomment -%}
      <div class="w-full md:hidden md:max-w-[464px] md:p-[24px]">
        <div class="product-media m-0! p-0! border-none!">
          <div class="relative">
            {%- comment -%} Main mobile media container. Now supports multiple media types. {%- endcomment -%}
            <div id="mobile-gallery-swipe-area-{{ section.id }}" class="relative aspect-[4/5] overflow-hidden">
              {%- for media in product.media -%}
                <div
                  class="product-main-media-mobile absolute inset-0 w-full h-full {% unless forloop.first %}hidden{% endunless %}"
                  data-media-id="{{ media.id }}"
                  data-media-type="{{ media.media_type }}"
                  aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
                >
                  {%- case media.media_type -%}
                    {%- when 'image' -%}
                      <img
                        src="{{ media | image_url: width: 1200 }}"
                        alt="{{ media.alt | escape }}"
                        class="object-cover w-full h-full"
                        height="{{ media.height }}"
                        width="{{ media.width }}"
                        loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                      >
                    {%- when 'external_video' -%}
                      {{
                        media
                        | video_tag:
                          class: 'w-full h-full object-cover',
                          image_size: '1200x',
                          controls: true,
                          autoplay: true
                      }}
                    {%- when 'video' -%}
                      {{
                        media
                        | video_tag:
                          class: 'w-full h-full object-cover',
                          image_size: '1200x',
                          controls: true,
                          autoplay: true
                      }}
                    {%- when 'model' -%}
                      {{
                        media
                        | model_viewer_tag:
                          class: 'w-full h-full',
                          image_size: '1200x',
                          interaction-prompt: 'auto',
                          camera-controls: true,
                          ar: true
                      }}
                  {%- endcase -%}
                </div>
              {%- endfor -%}
            </div>

            {%- comment -%} Slider Arrows {%- endcomment -%}
            <div class="absolute inset-0 z-2 flex items-center justify-between pointer-events-none d-sm:hidden">
              <button class="gallery-arrow prev pr-5 transition-colors pointer-events-auto" data-direction="prev">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path d="m15 18-6-6 6-6"/>
                </svg>
              </button>
              <button class="gallery-arrow pl-5 next transition-colors pointer-events-auto" data-direction="next">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path d="m9 18 6-6-6-6"/>
                </svg>
              </button>
            </div>

            {%- comment -%} Rating Block {%- endcomment -%}
            {%- assign rating_value = product.metafields.reviews.rating.value.rating | plus: 0 -%}
            {%- if rating_value > 0 -%}
              <div class="rating-container absolute bottom-4 left-4 z-2 p-2 capitalize!">
                {%- render 'rating-tailwind',
                  rating: product.metafields.reviews.rating.value,
                  rating_count: product.metafields.reviews.rating_count
                -%}
              </div>
            {%- endif -%}
          </div>

          {%- comment -%} Mobile Thumbnail Part (d-sm and up) {%- endcomment -%}
          <div class="hidden d-sm:flex gap-4 mt-4 overflow-x-auto">
            {% for media in product.media %}
              <button
                class="gallery-thumbnail relative flex-shrink-0 w-24 h-24 rounded-md overflow-hidden border-2 {% if forloop.first %}border-popsugar{% else %}border-transparent{% endif %} focus:border-popsugar"
                data-media-id="{{ media.id }}"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              >
                <img
                  src="{{ media.preview_image | image_url: width: 200 }}"
                  alt="{{ media.alt | escape }}"
                  class="w-full h-full object-cover"
                  height="96"
                  width="96"
                  loading="lazy"
                >
                {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                  <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-6 w-6 text-white"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                    >
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
                    </svg>
                  </div>
                {%- endif -%}
              </button>
            {% endfor %}
          </div>
        </div>
      </div>

      {%- comment -%}
        COLUMN 2: Product Information & Form
      {%- endcomment -%}
      <div class="w-full md:max-w-[490px] d-sm:max-w-[650px]! d-lg:max-w-[870px]! md:pl-[22px] md:pr-[22px] md:py-[24px] d-sm:pl-[20px] d-sm:pr-[36px] d-lg:pl-[20px] d-lg:pr-[3px] 2xl:mx-auto">
        <div class="product-info">
          <div class="w-full px-[16px] md:px-0 py-[24px] md:py-0! d-lg:py-[60px]">
            <div class="text-[24px] leading-[26px] tracking-[0.325px] font-[700] text-espresso d-lg:text-[36px] d-lg:leading-[40px] d-lg:tracking-[0.5px]">
              {{ product.title }}
            </div>
            {% comment %} <p class="text-lg text-gray-600 mt-1">{{ product.metafields.my_fields.subtitle | default: "18-DEVICE-MED" }}</p> {% endcomment %}

            {% comment %}
              <div class="flex items-center gap-2 mt-4 text-gray-500">
                {% render 'icon-leaf' %}
                {% render 'icon-allergens' %}
              </div>
            {% endcomment %}
            {%- if product.tags.size > 0 -%}
              <div class="flex items-center gap-3 mt-[12px]">
                {%- for tag in product.tags -%}
                  {%- liquid
                    # Convert tag to a handle to ignore case and spacing. E.g., "Gluten Free" becomes "gluten-free"
                    assign tag_handle = tag | handleize
                  -%}
                  {%- case tag_handle -%}
                    {%- when 'vegan' -%}
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="#39211B"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="lucide lucide-vegan-icon lucide-vegan"
                      >
                        <path d="M16 8q6 0 6-6-6 0-6 6"/><path d="M17.41 3.59a10 10 0 1 0 3 3"/><path d="M2 2a26.6 26.6 0 0 1 10 20c.9-6.82 1.5-9.5 4-14"/>
                      </svg>
                    {%- when 'egg-free' -%}
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="lucide lucide-egg-off-icon lucide-egg-off"
                      >
                        <path d="m2 2 20 20"/><path d="M20 14.347V14c0-6-4-12-8-12-1.078 0-2.157.436-3.157 1.19"/><path d="M6.206 6.21C4.871 8.4 4 11.2 4 14a8 8 0 0 0 14.568 4.568"/>
                      </svg>
                    {%- when 'nut-free' -%}
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="lucide lucide-nut-off-icon lucide-nut-off"
                      >
                        <path d="M12 4V2"/><path d="M5 10v4a7.004 7.004 0 0 0 5.277 6.787c.412.104.802.292 1.102.592L12 22l.621-.621c.3-.3.69-.488 1.102-.592a7.01 7.01 0 0 0 4.125-2.939"/><path d="M19 10v3.343"/><path d="M12 12c-1.349-.573-1.905-1.005-2.5-2-.546.902-1.048 1.353-2.5 2-1.018-.644-1.46-1.08-2-2-1.028.71-1.69.918-3 1 1.081-1.048 1.757-2.03 2-3 .194-.776.84-1.551 1.79-2.21m11.654 5.997c.887-.457 1.28-.891 1.556-1.787 1.032.916 1.683 1.157 3 1-1.297-1.036-1.758-2.03-2-3-.5-2-4-4-8-4-.74 0-1.461.068-2.15.192"/><line x1="2" x2="22" y1="2" y2="22"/>
                      </svg>
                    {%- when 'contains-nut' -%}
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="lucide lucide-nut-icon lucide-nut"
                      >
                        <path d="M12 4V2"/><path d="M5 10v4a7.004 7.004 0 0 0 5.277 6.787c.412.104.802.292 1.102.592L12 22l.621-.621c.3-.3.69-.488 1.102-.592A7.003 7.003 0 0 0 19 14v-4"/><path d="M12 4C8 4 4.5 6 4 8c-.243.97-.919 1.952-2 3 1.31-.082 1.972-.29 3-1 .54.92.982 1.356 2 2 1.452-.647 1.954-1.098 2.5-2 .595.995 1.151 1.427 2.5 2 1.31-.621 1.862-1.058 2.5-2 .629.977 1.162 1.423 2.5 2 1.209-.548 1.68-.967 2-2 1.032.916 1.683 1.157 3 1-1.297-1.036-1.758-2.03-2-3-.5-2-4-4-8-4Z"/>
                      </svg>
                    {%- when 'dairy-free' -%}
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="lucide lucide-milk-off-icon lucide-milk-off"
                      >
                        <path d="M8 2h8"/><path d="M9 2v1.343M15 2v2.789a4 4 0 0 0 .672 2.219l.656.984a4 4 0 0 1 .672 2.22v1.131M7.8 7.8l-.128.192A4 4 0 0 0 7 10.212V20a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2v-3"/><path d="M7 15a6.47 6.47 0 0 1 5 0 6.472 6.472 0 0 0 3.435.435"/><line x1="2" x2="22" y1="2" y2="22"/>
                      </svg>
                    {%- when 'gluten-free' -%}
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="lucide lucide-wheat-off-icon lucide-wheat-off"
                      >
                        <path d="m2 22 10-10"/><path d="m16 8-1.17 1.17"/><path d="M3.47 12.53 5 11l1.53 1.53a3.5 3.5 0 0 1 0 4.94L5 19l-1.53-1.53a3.5 3.5 0 0 1 0-4.94Z"/><path d="m8 8-.53.53a3.5 3.5 0 0 0 0 4.94L9 15l1.53-1.53c.55-.55.88-1.25.98-1.97"/><path d="M10.91 5.26c.15-.26.34-.51.56-.73L13 3l1.53 1.53a3.5 3.5 0 0 1 .28 4.62"/><path d="M20 2h2v2a4 4 0 0 1-4 4h-2V6a4 4 0 0 1 4-4Z"/><path d="M11.47 17.47 13 19l-1.53 1.53a3.5 3.5 0 0 1-4.94 0L5 19l1.53-1.53a3.5 3.5 0 0 1 4.94 0Z"/><path d="m16 16-.53.53a3.5 3.5 0 0 1-4.94 0L9 15l1.53-1.53a3.49 3.49 0 0 1 1.97-.98"/><path d="M18.74 13.09c.26-.15.51-.34.73-.56L21 11l-1.53-1.53a3.5 3.5 0 0 0-4.62-.28"/><line x1="2" x2="22" y1="2" y2="22"/>
                      </svg>
                  {%- endcase -%}
                {%- endfor -%}
              </div>
            {%- endif -%}

            <div class="pt-[32px]">
              {%- comment -%}
                Check if the product is on sale.
              {%- endcomment -%}
              {%- if product.compare_at_price > product.price -%}
                {%- comment -%} On Sale View {%- endcomment -%}
                <div class="price--on-sale self-stretch inline-flex flex-col justify-start items-start gap-0.5">
                  <span class="text-[24px] font-bold text-crimson leading-[26px] tracking-[0.325px] d-lg:text-[36px] d-lg:leading-[40px] d-lg-tracking-[0.5px]">
                    NOW<span class="t"> {{ product.price | money }}</span></span
                  >
                  <span class="text-[16px] leading-[22px] tracking-[0.325px] d-lg:text-[20px] d-lg:leading-[28px] d-lg-tracking-[0.4px] font-[600] text-crimson"
                    >WAS<span class=""> {{ product.compare_at_price | money }}</span></span
                  >
                  <span class="text-[12px] leading-[18px] tracking-[0.325px] font-[500] text-espresso mt-1"
                    >Tax included. <a href="/policies/shipping-policy" class="underline">Shipping</a> calculated at
                    checkout.</span
                  >
                </div>

              {%- else -%}
                {%- comment -%} Regular Price View {%- endcomment -%}
                <div class="price--regular">
                  <span class="text-[24px] font-[600] text-espresso">
                    {{- product.price | money -}}</span
                  ><br>
                  <span class="text-[12px] leading-[18px] tracking-[0.325px] d-lg:text-[16px] d-lg:leading-[24px] d-lg-tracking-[0.4px] font-[500] text-espresso mt-1"
                    >Tax included. <a href="/policies/shipping-policy" class="underline">Shipping</a> calculated at
                    checkout.</span
                  >
                </div>
              {%- endif -%}
            </div>

            {%- unless product.has_only_default_variant -%}
              <variant-radios class="block mt-8" data-section="{{ section.id }}" data-url="{{ product.url }}">
                {%- for option in product.options_with_values -%}
                  <fieldset class="js-variant-input-wrapper">
                    <legend class="font-semibold mb-2">{{ option.name }}</legend>
                    <div class="flex flex-wrap gap-2">
                      {%- for value in option.values -%}
                        <div>
                          <input
                            type="radio"
                            id="{{ section.id }}-{{ option.name | handle }}-{{ forloop.index0 }}"
                            name="{{ option.name }}"
                            value="{{ value | escape }}"
                            {% if option.selected_value == value %}
                              checked
                            {% endif %}
                            class="peer hidden"
                          >
                          <label
                            for="{{ section.id }}-{{ option.name | handle }}-{{ forloop.index0 }}"
                            class="
                              flex items-center gap-2 px-4 py-2 border-2 border-espresso rounded-xl cursor-pointer
                              text-espresso transition-all duration-200 hover:border-espresso/80
                              peer-checked:bg-popsugar  peer-checked:text-white
                            "
                          >
                            <svg
                              xmlns="http://www.w3.org/2000/svg"
                              width="20"
                              height="20"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              class="lucide lucide-cake-slice"
                            >
                              <path d="M16 13H3"/><path d="M16 17H3"/><path d="m7.2 7.9-3.388 2.5A2 2 0 0 0 3 12.01V20a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1v-8.654c0-2-2.44-6.026-6.44-8.026a1 1 0 0 0-1.082.057L10.4 5.6"/><circle cx="9" cy="7" r="2"/>
                            </svg>
                            <span class="font-medium">{{ value }}</span>
                          </label>
                        </div>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
              </variant-radios>
            {%- endunless -%}

            <div class="mt-8">
              {%- assign product_form_id = 'product-form-' | append: section.id -%}
              <product-form class="product-form">
                {%- form 'product',
                  product,
                  id: product_form_id,
                  class: 'form',
                  novalidate: 'novalidate',
                  data-type: 'add-to-cart-form'
                -%}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

                  <div class="md:flex md:gap-4">
                    <quantity-input>
                      <div class="flex justify-between w-[240px] h-[50px] items-center rounded-[6px] border-2 border-espresso bg-[#FFFCF9]  py-[16px]">
                        <button name="minus" type="button" class="quantity__button font-bold text-espresso">
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="#000000"
                            stroke-width="3"
