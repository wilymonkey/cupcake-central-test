{%- comment -%}
  A simple breaker section with customizable text, colors, and spacing.
{%- endcomment -%}

{%- if section.settings.text != blank -%}
  <div
    class="flex items-center justify-center text-center"
    style="
      background-color: {{ section.settings.background_color }};
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    "
  >
    <p
      class="font-bold uppercase tracking-wider"
      style="
        color: {{ section.settings.text_color }};
        font-size: {{ section.settings.font_size }}px;
      "
    >
      {{ section.settings.text }}
    </p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Custom Breaker",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "ANNOUNCEMENT BAR"
    },
    {
      "type": "header",
      "content": "Style & Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#26A69A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Font Size",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top Padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Custom Breaker"
    }
  ]
}
{% endschema %}