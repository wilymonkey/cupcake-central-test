                                  </button>
                                {%- endform -%}
                              </product-form>
                            {%- endif -%}
                          {%- endif -%}
                        </div>
              </div>
              </div>
            </a>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>
<div class="view-more">
  <button id="view-more-button" class="view-more-button">SHOW MORE</button>
</div>
<div class="how-to-heat-container">
  <h2 class="cookies-heading">HOW TO HEAT</h2>
  <div class="how-to-heat-steps-container">
    <div class="heat-step1">
      <div class="heat-step1-text">
        <div class="heat-step1-text1">1</div>
        <div class="heat-step1-text2">TAKE OUT THE COOKIE <span style="font-weight: bold">FROM IT’S PACKAGE</span></div>
      </div>
      <div class="heat-step1-image">
        <img
              class="lazyload"
              src="https://cdn.shopify.com/s/files/1/1848/3097/files/Group_580.svg?v=1724649573"
              alt="service Image"
              width="120"
              height="150"
            >
      </div>
    </div>
    <div class="arrow-image">
    <img
      src="https://cdn.shopify.com/s/files/1/1848/3097/files/Group_549.svg?v=1724652411"
      alt="Arrow"
      width="50"
      height="50"
    >
  </div>
    <div class="heat-step2">
      <div class="heat-step2-text">
        <div class="heat-step2-text1">2</div>
        <div class="heat-step2-text2">PLACE IN THE MICROWAVE <span style="font-weight: bold">HEAT FOR 15 SECONDS</span></div>
      </div>
      <div class="heat-step2-image">
        <img
              class="lazyload"
              src="https://cdn.shopify.com/s/files/1/1848/3097/files/Group_579.svg?v=1724649573"
              alt="service Image"
              width="120"
              height="150"
            >
      </div>
    </div>
    <div class="arrow-image">
    <img
      src="https://cdn.shopify.com/s/files/1/1848/3097/files/Group_549.svg?v=1724652411"
      alt="Arrow"
      width="50"
      height="50"
    >
  </div>
    <div class="heat-step3">
      <div class="heat-step3-text">
        <div class="heat-step3-text1">3</div>
        <div class="heat-step3-text2">ENJOY YOUR <span style="font-weight: bold">OOEY GOOEY COOKIE</span></div>
      </div>
      <div class="heat-step3-image">
        <img
              class="lazyload"
              src="https://cdn.shopify.com/s/files/1/1848/3097/files/Group_578.svg?v=1724649573"
              alt="service Image"
              width="120"
              height="150"
            >
      </div>
    </div>
  </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
    // Initially hide all items after the first 4 in each section
    const productItems1 = document.querySelectorAll('.cookies-product-item1');
    const productItems2 = document.querySelectorAll('.cookies-product-item2');

    productItems1.forEach((item, index) => {
      if (index >= 4) {
        item.classList.add('hidden');
      }
    });

    productItems2.forEach((item, index) => {
      if (index >= 4) {
        item.classList.add('hidden');
      }
    });

    // Show all items on button click
    document.getElementById('view-more-button').addEventListener('click', function () {
      productItems1.forEach(item => item.classList.remove('hidden'));
      productItems2.forEach(item => item.classList.remove('hidden'));

      // Optionally hide the button after clicking
      this.style.display = 'none';
    });
  });
</script>
{% schema %}
{
  "name": "Cookies Landing Page",
  "settings": [],
  "blocks": [
   {
     "type": "image",
     "name": "Collection",
     "settings": [
       {
         "type": "image_picker",
         "id": "image",
         "label": "Image",
         "info":"Size : 50px X 50px"
       },
       {
         "type": "text",
         "id": "title",
         "label": "Title",
         "default": "item title"
       },
       {
         "type": "url",
         "id": "link",
         "label": "Link"
       }
     ]
   }
 ],
  "presets": [
  {
    "name": "Cookies Landing"
    }
  ]
}
{% endschema %}
