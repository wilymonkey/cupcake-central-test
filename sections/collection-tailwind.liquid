{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #main-collection-filters .facets__summary .facets__button {
    font-size: 14px !important;
    font-weight: 600 !important;
    padding: 8px 16px !important;
    border: 1px solid #d1d5db !important;
    border-radius: 8px !important;
    background-color: #f9fafb !important;
    color: #1f2937 !important;
  }

  #main-collection-filters .facets__summary .facets__button svg {
    width: 18px !important;
    height: 18px !important;
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding" style="background-color: {{ section.settings.background_color }};">
  {%- paginate collection.products by section.settings.products_per_page -%}
    <div>
      {%- comment -%} Collection Banner Logic Starts Here {%- endcomment -%}
      <div class="mb-8">
        {%- assign banner_metafield = collection.metafields.collection.banner.value -%}

        {%- if section.settings.show_collection_image and banner_metafield.desktop_image -%}
          {%- comment -%}
            This is the new banner that uses your metafield data.
          {%- endcomment -%}
          <div class="relative w-full h-[500px] d-sm:h-[31.5vw] overflow-hidden">
            {%- comment -%} Desktop Image from Metafield {%- endcomment -%}
            <img
              src="{{ banner_metafield.desktop_image | image_url: width: 1800 }}"
              alt="{{ banner_metafield.desktop_image.alt | escape }}"
              width="{{ banner_metafield.desktop_image.width }}"
              height="{{ banner_metafield.desktop_image.height }}"
              class="hidden d-sm:block! w-full h-full object-cover"
            >
            {%- comment -%} Mobile Image from Metafield {%- endcomment -%}
            <img
              src="{{ banner_metafield.mobile_image | image_url: width: 1000 }}"
              alt="{{ banner_metafield.mobile_image.alt | escape }}"
              width="{{ banner_metafield.mobile_image.width }}"
              height="{{ banner_metafield.mobile_image.height }}"
              class="block d-sm:hidden w-full h-full object-cover"
            >

            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>

            <div class="absolute inset-0 flex flex-col items-center justify-end p-8 text-center text-white d-sm:pr-[44px] d-sm:justify-center d-sm:items-end d-sm:text-center">
              <div>
              <p
                class="text-[36px] m-xs:text-[48px] d-sm:text-[72px] leading-[33px]! m-xs:leading-[44px]! d-sm:leading-[66px]! font-black tracking-normal! [text-shadow:_0px_8px_16px_rgb(0_0_0_/_0.16)] d-sm:max-w-[605px] d-sm:px-14 pb-5 d-sm:pb-0"
                style="color: {{ section.settings.banner_heading_color }};"
              >
                {{ banner_metafield.title | escape }}
              </p>
              {%- if banner_metafield.description != blank -%}
                <div
                  class="d-sm:px-0 text-[18px] text-center m-xs:text-[24px] t-md:text:[24px] d-sm:text-[36px] m-xs:leading-[26px]! t-md:leading-[26px]! d-sm:leading-[40px]! d-sm:max-w-[600px] font-[700] tracking-[0.325px] leading-[20px]! d-sm:py-5 [text-shadow:_0px_8px_16px_rgb(0_0_0_/_0.16)]"
                  style="color: {{ section.settings.banner_subheading_color }};"
                >
                  {{ banner_metafield.description }}
                </div>
              {%- endif -%}
            </div>
            </div>
          </div>
        {%- elsif section.settings.show_collection_image and collection.image -%}
          {%- comment -%}
            This is the FALLBACK banner that uses the default collection image.
          {%- endcomment -%}
          <div class="relative w-full h-[500px] d-sm:h-auto d-sm:aspect-[1920/585] overflow-hidden">
            <img
              src="{{ collection.image | image_url: width: 1800 }}"
              alt="{{ collection.image.alt | escape }}"
              width="{{ collection.image.width }}"
              height="{{ collection.image.height }}"
              class="w-full h-full object-cover"
            >
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>

            {%- comment -%} THIS IS THE CORRECTED LINE {%- endcomment -%}
            <div class="absolute inset-0 flex flex-col items-center justify-end p-8 text-center text-white d-sm:justify-center d-sm:items-end d-sm:text-right">
              <p
                class="text-[48px] d-sm:text-[48px] d-lg:text-[70px] d-sm:leading-[33px] font-black leading-[44px]! tracking-normal! [text-shadow:_0px_8px_16px_rgb(0_0_0_/_0.16)]"
                style="color: {{ section.settings.banner_heading_color }};"
              >
                {{ collection.title }}
              </p>
              {% comment %}
                {%- if collection.description != blank -%}
                  <div
                    class="rte d-sm:max-w-[1184px] mx-auto py-5 text-center px-10 d-sm:px-0 text-[24px] font-[700] tracking-[0.325px] leading-[22px] d-sm:py-5 d-sm:text-[24px] d-sm:leading-[34px] [text-shadow:_0px_8px_16px_rgb(0_0_0_/_0.16)]"
                    style="color: {{ section.settings.banner_subheading_color }};"
                  >
                    {{ collection.description }}
                  </div>
                {%- endif -%}
              {% endcomment %}
            </div>
          </div>
        {% else %}
          {%- comment -%} Fallback header for collections without any image {%- endcomment -%}
          <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-gray-800 d-sm:text-4xl">{{ collection.title }}</h1>
            {%- if collection.description != blank -%}
              <div class="rte max-w-2xl mx-auto mt-4 text-gray-600">{{ collection.description }}</div>
            {%- endif -%}
          </div>
        {% endif %}
      </div>

      {%- comment -%} Facets and Sorting Bar {%- endcomment -%}
      <div
        class="mb-8 px-[2rem] m-xs:px-[1rem] m-sm:max-w-[950px] m-sm:mx-auto d-sm:max-w-[1000px] d-sm:mx-auto collection-filters-override"
        id="main-collection-filters"
        data-id="{{ section.id }}"
      >
        {% render 'facets',
          results: collection,
          enable_filtering: section.settings.enable_filtering,
          enable_sorting: section.settings.enable_sorting,
          filter_type: 'drawer'
        %}
      </div>

      {%- comment -%} Product Grid {%- endcomment -%}
      <div id="ProductGridContainer" data-id="{{ section.id }}">
        <div class="collection">
          <div class="flex justify-center pb-10">
            <div class="grid grid-cols-2 d-sm:grid-cols-4 pl-[2rem]! m-xs:pl-[0rem]! m-sm:pl-[3rem]! d-sm:pl-0! gap-x-5! gap-y-5! d-sm:gap-y-8! d-sm:gap-x-8! w-[392px] m-sm:w-[1000px] d-sm:w-[1000px]">
              {%- for product in collection.products -%}
                {% render 'card-product-collection-v2', card_product: product, section_id: section.id %}
              {%- else -%}
                <div class="col-span-full text-center py-16">
                  <h2 class="text-2xl font-bold">No products found</h2>
                  <p class="mt-2 text-crimson">Try adjusting your filters to find what you're looking for.</p>
                </div>
              {%- endfor -%}
            </div>
          </div>

          {%- if paginate.pages > 1 -%}
            <div class="mt-1 pb-4">
              {% render 'pagination', paginate: paginate %}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collection Page",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#F9FAFB"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "label": "Show collection image",
      "default": true
    },
    {
      "type": "header",
      "content": "Banner Text Colors"
    },
    {
      "type": "color",
      "id": "banner_heading_color",
      "label": "Banner Heading Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "banner_subheading_color",
      "label": "Banner Subheading Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 24,
      "step": 4,
      "default": 16,
      "label": "Products per page"
    },
    {
      "type": "header",
      "content": "Filtering and Sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "Enable filtering"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "Enable sorting"
    }
  ]
}
{% endschema %}
