{%- comment -%}
  This section file contains the settings and passes them to the snippet file.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- render 'delivery-checker-snippet',
  image: section.settings.image,
  heading: section.settings.heading,
  subheading: section.settings.subheading,
  section_background_color: section.settings.section_background_color,
  content_background_color: section.settings.content_background_color,
  melbourne_postcodes: section.settings.melbourne_postcodes,
  success_heading: section.settings.success_heading,
  success_subheading: section.settings.success_subheading,
  close_heading: section.settings.close_heading,
  close_subheading: section.settings.close_subheading,
  sorry_heading: section.settings.sorry_heading,
  sorry_subheading: section.settings.sorry_subheading,
  section_id: section.id
-%}

{% schema %}
{
  "name": "Delivery Zone Checker",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "color",
      "id": "section_background_color",
      "label": "Section Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "content_background_color",
      "label": "Content Background Color",
      "default": "#26A69A"
    },
    {
      "type": "header",
      "content": "Default Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Delivery Zones"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Main Subheading",
      "default": "Are you in the Sweet Zone?"
    },
    {
      "type": "header",
      "content": "Delivery Logic"
    },
    {
      "type": "textarea",
      "id": "melbourne_postcodes",
      "label": "Melbourne Postcodes",
      "info": "Enter all valid Melbourne postcodes, separated by commas (e.g., 3000, 3001, 3002)."
    },
    {
      "type": "header",
      "content": "Response Messages"
    },
    {
      "type": "text",
      "id": "success_heading",
      "label": "Success Heading",
      "default": "Good news!"
    },
    {
      "type": "text",
      "id": "success_subheading",
      "label": "Success Subheading",
      "default": "You are in the sweet zone!"
    },
    {
      "type": "text",
      "id": "close_heading",
      "label": "'So Close' Heading",
      "default": "So close!"
    },
    {
      "type": "text",
      "id": "close_subheading",
      "label": "'So Close' Subheading",
      "default": "You are just outside the Zone!"
    },
    {
      "type": "text",
      "id": "sorry_heading",
      "label": "'Sorry' Heading",
      "default": "Sorry!"
    },
    {
      "type": "text",
      "id": "sorry_subheading",
      "label": "'Sorry' Subheading",
      "default": "Sorry, you are not in the sweet zone."
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Delivery Zone Checker"
    }
  ]
}
{% endschema %}