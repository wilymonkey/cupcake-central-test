{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

    <div>
      <h1 class="heading1" style="color: #66686c; text-align: center;">{{ section.settings.heading }}</h1>
    </div>
  <div class="background-container2">
  {% if section.blocks.size > 0 %}
    {% for block in section.blocks %}
    <div class="store-div">
    <div class="store-image">
      <img 
        class="store-image-src" 
        src="{{ block.settings.image | img_url: 'master' }}" 
        alt="Opening hour clock" 
        height="300px" 
        width="350px"></div>
    <div class="store-details-container">
      <div class="store-details-container1">
      <div class="store-name">{{ block.settings.store_name }}</div>
      </div>
      <div class="store-details-container2">
        <div class="store-details-container1-left">
          <div class="store-address">{{ block.settings.store_address }}</div>
        </div>
        <div class="store-details-container2-right">
            <div class="store-timings">
              <div> {{ block.settings.store_open_day1 }} <span style="font-size: 12px; text-align: right;"> {{ block.settings.store_open_time1 }} </span></div>
              <div> {{ block.settings.store_open_day2 }} <span style="font-size: 12px; text-align: right;"> {{ block.settings.store_open_time2 }} </span></div>
              <div> {{ block.settings.store_open_day3 }} <span style="font-size: 12px; text-align: right;"> {{ block.settings.store_open_time3 }} </span></div>
              <div> {{ block.settings.store_open_day4 }} <span style="font-size: 12px; text-align: right;"> {{ block.settings.store_open_time4 }} </span></div>
            </div>
        </div>
      </div>
      <div class="store-details-container3">
      <button 
        class="direction-button" 
        style="font-family: Poppins; cursor: pointer !important;" 
        onclick="window.open('{{ block.settings.link }}', '_blank')">
        GET DIRECTIONS
      </button>
</div>

  </div>
    </div>
    {% endfor %}
    {% endif %}
  </div>

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "DELIVERY LOCATIONS",
      "label": "DELIVERY LOCATIONS"
    }
  ],
  "blocks": [
     {
       "type": "text",
       "name": "Stores",
       "settings": [
         {
           "type": "image_picker",
           "id": "image",
           "label": "Image",
           "info":"Size : 300px X 350px"
         },
         {
           "type": "text",
           "id": "store_name",
           "label": "Store Name",
           "default": "Store Name"
         },
         {
           "type": "text",
           "id": "store_address",
           "label": "Store Address",
           "default": "Store Address"
         },
         {
           "type": "text",
           "id": "store_open_day1",
           "label": "Store Open Days 1",
           "default": "Store Open Days 1"
         },
         {
           "type": "text",
           "id": "store_open_time1",
           "label": "Store Open Time 1",
           "default": "Store Open Time 1"
         },
         {
           "type": "text",
           "id": "store_open_day2",
           "label": "Store Open Days 2",
           "default": "Store Open Days 2"
         },
         {
           "type": "text",
           "id": "store_open_time2",
           "label": "Store Open Time 2",
           "default": "Store Open Time 2"
         },
         {
           "type": "text",
           "id": "store_open_day3",
           "label": "Store Open Days 3",
           "default": "Store Open Days 3"
         },
         {
           "type": "text",
           "id": "store_open_time3",
           "label": "Store Open Time 3",
           "default": "Store Open Time 3"
         },
         {
           "type": "text",
           "id": "store_open_day4",
           "label": "Store Open Days 4",
           "default": "Store Open Days 4"
         },
         {
           "type": "text",
           "id": "store_open_time4",
           "label": "Store Open Time 4",
           "default": "Store Open Time 4"
         },
         {
           "type": "url",
           "id": "link",
           "label": "Link"
         }
       ]
     }
   ],
  "presets": [
    {
      "name": "Delivery Locations"
    }
  ]
}
{% endschema %}