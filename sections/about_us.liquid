{{ 'about_us.css' | asset_url | stylesheet_tag }}

{% assign mp4Url = "" %}
{% assign posterUrl = section.settings.video.preview_image.src %}
{% for source in section.settings.video_file.sources %}
  {% if source.format == "mp4" %}
    {% assign mp4Url = source.url %}
  {% endif %}
{% endfor %}

<div class="video-container">
  <video 
    class="full-width-video" 
    width="100%" 
    height="500px" 
    autoplay 
    loop 
    muted 
    playsinline 
    poster="https://cupcakecentral.com.au/cdn/shop/{{ posterUrl }}">
    <source src="{{ mp4Url }}" type="video/mp4">
  </video>
</div>

<div class="about-us-container">
  <div class="about-us-container-image">
    <img
        class="about-us-image"
        src="{{ section.settings.image-about-us | img_url: 'master' }}"
        alt="about us Image"
      >
  </div>
  <div class="about-us-container-text">
    <div class="about-us-container-text-header">ABOUT <span style="font-family: Tenstars; color:#f682b1; font-size: 84px; font-weight: 400;">Us</span></div>
    <div class="about-us-container-text-text">{{ section.settings.text-about-us }}</div>
  </div>
</div>

<div class="our-products-container">
  <div class="our-products-container-inside">
  <div class="our-products-container-text">
    <div class="our-products-container-text-header"><span style="font-family: Tenstars; color:#f682b1; font-size: 84px; font-weight: 400;">Our </span>Products</div>
    <div class="our-products-container-text-text">{{ section.settings.text-our-products }}</div>
  </div>
  <div class="our-products-container-image">
    <img
        class="our-products-image"
        src="{{ section.settings.image-our-products | img_url: 'master' }}"
        alt="about us Image"
      >
  </div> 
  </div>
</div>

<div class="our-team-container">
  <div class="our-team-container-image">
    <img
        class="our-team-image"
        src="{{ section.settings.image-our-team | img_url: 'master' }}"
        alt="about us Image"
      >
  </div> 
  <div class="our-team-container-text">
    <div class="our-team-container-text-header"><span style="font-family: Tenstars; color:#f682b1; font-size: 84px; font-weight: 400;"> Our </span>Team</div>
    <div class="our-team-container-text-text">{{ section.settings.text-our-team }}</div>
  </div>
  </div>


{% schema %}
  {
    "name": "About Us",
    "settings": [
      {
      "type": "video",
      "id": "video_file",
      "label": "Upload Video"
    },
      {
        "type": "image_picker",
        "id": "image-about-us",
        "label": "Image for About Us"
      },
      {
        "type": "text",
        "id": "text-about-us",
        "label": "Text for About Us"
      },
      {
        "type": "image_picker",
        "id": "image-our-products",
        "label": "Image for Our Products"
      },
      {
        "type": "text",
        "id": "text-our-products",
        "label": "Text for Our Products"
      },
      {
        "type": "image_picker",
        "id": "image-our-team",
        "label": "Image for Our Team"
      },
      {
        "type": "text",
        "id": "text-our-team",
        "label": "Text for Our Team"
      }
    ],
    "presets": [
    {
      "name": "About Us"
      }
    ]   
  }
{% endschema %}