{% schema %}
{
  "name": "IWD Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WHY IWD?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "IWD is an initiative dedicated to providing lifelong support, resources, and advocacy for women’s empowerment and equality."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "url",
      "id": "button_link2",
      "label": "Button Link2"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "ORDER NOW"
    },
    {
      "type": "text",
      "id": "button_text2",
      "label": "Button Text2",
      "default": "ORDER NOW"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Left Image"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Right Image"
    }
  ],
  "presets": [
    {
      "name": "IWD Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<section class="iwd-section">
  <div class="iwd-container">
    <div class="iwd-text">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      <a href="{{ section.settings.button_link }}" class="iwd-button">
        {{ section.settings.button_text }}
      </a>
      <a class="iwd-button1" data-target="ordernow-block-iwd">
        {{ section.settings.button_text2 }}
      </a>
    </div>
    <div class="iwd-images">
      {% if section.settings.image_1 %}
        <img src="{{ section.settings.image_1 | img_url: '500x' }}" alt="IWD Image 1" class="image-1">
      {% endif %}
      {% if section.settings.image_2 %}
        <img src="{{ section.settings.image_2 | img_url: '500x' }}" alt="IWD Image 2" class="image-2">
      {% endif %}
    </div>
  </div>
</section>
<script>
  document.querySelectorAll('.iwd-button1, .smooth-scroll-button').forEach(button => {
    button.addEventListener('click', function (e) {
      e.preventDefault();
      const targetId = this.getAttribute('data-target');
      const targetSection = document.getElementById(targetId);

      if (targetSection) {
        const offsetTop = targetSection.getBoundingClientRect().top + window.scrollY - 220; // Adjust -220 if needed
        window.scrollTo({ top: offsetTop, behavior: 'smooth' });
      }
    });
  });
</script>
<style>
.iwd-section {
  background: #fff;
  padding: 50px 20px;
  text-align: center;
}
  
.iwd-container {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: auto;
  justify-content: center;
}
  
.iwd-text {
  width: 40%;
}
  
.iwd-text h2 {
  color: #4a148c;
  font-size: 3rem;
  font-weight: bold;
}
  
.iwd-text p {
  color: #333;
  font-size: 1.4rem;
    line-height: 28px;
  padding: 29px;
  padding-top: 0px;
  text-align: center;
}

  .image2, .image-1:hover  {
      transform: scale(1.1);
  }
  
  
.iwd-button, .iwd-button1 {
    display: inline-block;
    background: white;
    color: #2A227A;
    padding: 10px 20px;
    text-decoration: none;
    margin-top: 10px;
    border-radius: 5px;
    border: 1px solid #2A227A;
    font-weight: bold;
    font-size: 14px;
    transition: all 0.3s ease-in-out;
}

.iwd-button:hover, .iwd-button1:hover {
    background: #2b2181;
    color: white;
    padding: 10px 40px; /* Expands width by 20px on both sides */
    box-shadow: 0 0 10px #2A227A;
}
  
.iwd-images {
    display: flex;
    gap: 20px;
    margin-top: 20px;
    overflow: hidden; /* Ensures no overflow */
}
  
.iwd-images img {
  width: 45%;
  border-radius: 10px;
}
@media (max-width: 1100px) {
  .iwd-text {
    width: 90%;
}
  }

/* 🌟 Hide the second image on screens 768px or less */
@media (max-width: 768px) {
  .iwd-section {
    background: #fff;
    padding: 0px 0px;
    text-align: center;
}
  .iwd-images {
    flex-direction: column;
  }
  
  .iwd-images .image-1 {
    width: 100vw;
    height: 288px;
    object-fit: cover;
  }
  
  .iwd-images .image-2 {
    display: none; /* Hides the second image */
  }

  .iwd-container {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    margin: auto;
    background: #f9f1e4;
    justify-content: center;
  }
  
  .iwd-text {
    width: 94%;
    background: white;
    margin-top: -75px;
    opacity: 0.89;
    border-radius: 10px;
    padding-bottom: 20px;
  }
  .iwd-text p {
    color: #333;
    font-size: 13px;
    line-height: 20px;
    width: 95%;
    margin: auto;
}
</style>
