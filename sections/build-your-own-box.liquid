<div class="flex flex-col space-x-4 bg-orange-100 p-8"
    data-box-quantity="{{ section.settings.box_quantity }}"
    data-box-price="{{ section.settings.box_price }}"
>
    <!--Breadcrumbs, not functional -->
    <div>
        <nav class="flex space-x-2 uppercase items-center font-bold">
            <a class="text-sm">Cakes:</a>
            <a class="text-sm">Pick your own cupcake</a>
            <div>></div>
            <a class="text-sm">{{ section.settings.box_quantity }} assorted cupcake gift box</a>
        </nav>
    </div>
    <div class="max-w-7xl mx-auto">
        <div class="grid md:grid-cols-2 py-4 gap-4">

            <!-- CUPCAKE SELECTION -->

            <div class="flex flex-col rounded-2xl bg-white border-zinc-400 !border-1 p-8">
                <h5>1. PICK YOUR CUPCAKES</h5>
                <hr class="!my-4">
                <div class="grid grid-cols-3 gap-4">
                    {% for cupcake in metaobjects.cupcake.values %}
                    {% if cupcake.stock > 0 %}
                    {% assign id = cupcake.name | sha256 | truncate: 12 %}
                    <div class="flex flex-col items-stretch gap-2">
                        <img draggable="true" data-cupcake-image="{{ id }}" class="w-full aspect-square" width="256" height="256" src="{{ cupcake.image | image_url  }}" alt="{{ cupcake.name }} cupcake">
                        <div class="font-bold uppercase text-[1rem] text-center"
                            data-cupcake-name="{{ id }}"
                        >
                            {{ cupcake.name }}
                        </div>
                        <div class="h-1 grow"> </div>
                        <div class="flex !border-1 border-zinc-400 rounded-md p-2 items-center"
                            data-cupcake-id="{{ id }}"
                            data-cupcake-stock="{{ cupcake.stock }}"
                            data-cupcake-image="{{ cupcake.image | image_url }}"
                        >
                            <button data-action="decrement" class="px-2 disabled:opacity-50" disabled>-</button>
                            <div data-role="count" class="grow w-1 px-4 text-center font-bold text-lg"> </div>
                            <button data-action="increment" class="px-2 font-bold !text-teal-500 disabled:text-[unset] disabled:opacity-50" disabled>+</button>
                        </div>
                    </div>
                    {% endif %}
                    {% endfor %}
                </div>
            </div>

            <!-- USER FEEDBACK -->

            <div class="flex flex-col gap-4 bg-white rounded-2xl border-zinc-400 !border-1 p-8">
                <h5 class="flex">
                    <div>2. GIFT BOX PREVIEW</div>
                    <div class="grow w-1"> </div>
                    <div class="flex gap-2">
                        <span id="cupcake-counter"></span>
                        <span>/</span>
                        <span>{{ section.settings.box_quantity }}</span>
                    </div>
                </h5>
                <div class="hidden">
                    <img class="w-full aspect-square" id="empty-cupcake-image" width="48" height="48" src="{{ 'cupcakes/EmptyCupcake.png' | asset_url  }}" alt="empty cupcake wrapper">
                </div>
                <div class="relative">
                    <div class="bg-zinc-100 w-full h-150 rounded-2xl !border-1 border-zinc-300"> </div>
                    <button id="reset-gift-box" class="absolute z-1 top-2 right-2 text-red-500 disabled:hidden" disabled>
                        <svg class="size-16" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                          <path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25Zm-1.72 6.97a.75.75 0 1 0-1.06 1.06L10.94 12l-1.72 1.72a.75.75 0 1 0 1.06 1.06L12 13.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L13.06 12l1.72-1.72a.75.75 0 1 0-1.06-1.06L12 10.94l-1.72-1.72Z" clip-rule="evenodd" />
                        </svg>
                    </button>
                    <div class="absolute inset-0 px-12 flex items-center" id="cupcake-dropzone">
                        <div class="h-58 aspect-[2/1] px-4 grid border-4 !gap-0 bg-white border-teal-500 items-center" id="cupcake-preview" style="grid-template-columns: repeat({{ section.settings.box_cupcakes_per_rows }}, 1fr)"></div>
                    </div>
                </div>

                <!-- ADDONS -->

                <h5>3. PICK YOUR ADDONS</h5>
                <div class="grid grid-cols-3 mx-auto max-w-sm">
                    {% for addon in metaobjects.addon.values %}
                    <label class="flex flex-col items-center gap-2 cursor-pointer relative">
                        <input
                            data-addon-id="{{ addon.name | sha256 | truncate: 8 }}"
                            data-addon-price="{{ addon.price }}"
                            data-addon-name="{{ addon.name }}"
                            class="peer hidden" type="checkbox" name="addons"
                            value="{{ addon.name }}"
                        >
                        <img class="peer-checked:ring-3 peer-checked:-ring-offset-1 peer-checked:ring-teal-500 rounded-full" width="128" height="128" src="{{ addon.image | image_url  }}" alt="{{ addon.name }} addon">
                        <svg class="peer-checked:!block absolute hidden bottom-6 right-0 size-12 stroke-teal-500 fill-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                        </svg>
                        <span class="text-lg font-bold">
                            {% if addon.price == 0 %}
                                FREE
                            {% else %}
                                {{ addon.price | money }}
                            {% endif %}
                        </span>
                    </label>
                    {% endfor %}
                </div>
                <div class="h-1 grow"> </div>
                <hr class="!my-4">
                <div class="flex justify-end gap-4 items-center">
                    <h5 class="!text-teal-500" id="total-price"></h5>
                    <button id="add-to-cart" class="bg-teal-500 disabled:bg-zinc-400 text-lg text-white p-4 rounded-md font-bold" disabled>ADD TO CART</button>
                </div>
            </div>
        </div>

        <div class="h-16"> </div>

        <!-- RECOMMENDATIONS -->

        <h5 class="text-center w-full !text-zinc-700 mb-4">YOU MAY ALSO LIKE</h5>
        <div class="flex gap-2 overflow-x-auto">
            {% for recommend in metaobjects.recommendation.values %}
            <div class="!border-1 border-zinc-400 rounded-2xl p-4 max-w-xs flex flex-col gap-4 bg-white">
                <img class="" width="256" height="256" src="{{ recommend.image | image_url  }}" alt="{{ recommend.title }} recommended">
                <div class="uppercase font-bold text-xl">{{ recommend.title }}</div>
                <div class="uppercase font-bold text-xl">{{ recommend.price | money }}</div>
                <a href="{{ recommend.url }}" class="bg-white border-zinc-400 !border-1 text-xs p-4 rounded-md font-bold max-w-32">SHOP NOW</a>
            </div>
            {% endfor %}
        </div>

        <div class="h-16"> </div>

        <!-- REVIEWS -->

        <h5 class="text-center w-full !text-zinc-700 mb-8">REVIEWS</h5>
        {% render 'build-your-own-box-reviews' %}
    </div>
</div>

<script src="{{ 'build-your-own-box.js' | asset_url }}" defer></script>

{% schema %}

{
   "name":"Build Your Own Box",
   "settings":[
      {
         "type":"number",
         "id":"box_quantity",
         "default":12,
         "label":"Box quantity"
      },
      {
         "type":"number",
         "id":"box_cupcakes_per_rows",
         "default":6,
         "label":"Cupcakes per row of the box"
      },
      {
         "type":"number",
         "id":"box_price",
         "default":5200,
         "label":"Box price"
      }
   ]
}

{% endschema %}
