<div class="bg-orange-100 p-8 h-full">
  <h2>{{ section.settings.heading }}</h2>
  <p>{{ section.settings.text }}</p>
</div>

{% schema %}
{
  "name": "Build Your Own Box",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hello world"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Your content here"
    }
  ],
  "presets": [
    {
      "name": "Build Your Own Box"
    }
  ]
}
{% endschema %}
