{%- comment -%}
  CHRISTMAS MAGIC Section
  Renders the bento-grid-snippet but using Christmas settings.
{%- endcomment -%}

{%- render 'christmas-magic-snippet',
  image: section.settings.image,
  hover_image: section.settings.hover_image,
  heading: section.settings.heading,
  subheading: section.settings.subheading,
  text: section.settings.text,
  button_text: section.settings.button_text,
  button_link: section.settings.button_link,
  text_alignment: section.settings.text_alignment,
  image_position: section.settings.image_position,
  image_orientation: section.settings.image_orientation,
  image_style: section.settings.image_style,
  background_color: section.settings.background_color,
  hover_effect: section.settings.hover_effect
-%}

{% schema %}
{
  "name": "Christmas Magic",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Christmas Image"
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Image Link",
      "info": "Optional: Link when clicking the image"
    },
    {
      "type": "image_picker",
      "id": "hover_image",
      "label": "Christmas Hover Image",
      "info": "This image will appear when hovering over the main image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Christmas Heading",
      "default": "Merry Christmas"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Small Heading",
      "default": "This is a small subtitle"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Christmas Description",
      "default": "<p>Celebrate the festive season with warmth, joy, and Christmas magic.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Christmas"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFF4E6"
    },
    {
      "type": "radio",
      "id": "image_style",
      "label": "Image Style",
      "options": [
        { "value": "filled", "label": "Filled" },
        { "value": "framed", "label": "Framed" }
      ],
      "default": "framed"
    },
    {
      "type": "radio",
      "id": "image_orientation",
      "label": "Image Orientation",
      "options": [
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "radio",
      "id": "image_position",
      "label": "Image Position (Desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Hover Effect Settings"
    },
    {
      "type": "checkbox",
      "id": "hover_effect",
      "label": "Enable Hover Image Effect",
      "default": true,
      "info": "Show hover image when hovering over the main image"
    }
  ],
  "presets": [
    {
      "name": "Christmas Magic Section"
    }
  ]
}
{% endschema %}