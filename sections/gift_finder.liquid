{{ 'gift_finder.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

<div class="input-form-container">
  <div class="gift-finder-header">
    <h1>FIND YOUR PERFECT GIFT</h1>
  </div>

  <div class="form-design">
    <div class="recipient-container" style="cursor: pointer;">
      <div class="recipient-header">
        <label class="recipient" for="recipient">I am looking for a gift:</label>
        <button
          type="button"
          id="dropdownButtonRec"
          style="width:30px; background-color: white; border: none; font-size: 12px; position: absolute; right: 0; cursor: pointer; height: 100%; width: 100%; background-color: transparent;"
        >
          <img
            src="https://cdn.shopify.com/s/files/1/1848/3097/files/arrow-down-sign-to-navigate_1.png?v=1716420225"
            id="dropdownIcon1"
            style="height:17px; width: 17px; cursor: pointer; position: absolute; right: 0; top:0; margin-right: 10px; margin-top:20px;"
          >
        </button>
      </div>

      <input
        type="text"
        id="chosen_input1"
        class="chosen_input1"
        readonly
        style="border: none; width: 50%; padding-left: 10px; font-size: 15px; font-family: poppins;"
        data-recipient-value="{{ section.settings.default_recipient }}"
      >

      <div
        id="recipient-dropdown"
        class="recipient-dropdown"
        name="recipient"
        style="display: none; position: absolute; top: 60px; border: 1px solid black; z-index: 99"
      >
        {%- assign recipient_choices = section.settings.recipient_choices | split: ', ' -%}
        {% for recipient_choice in recipient_choices %}
          {%- assign each_recipient = recipient_choice | split: ': ' | first -%}
          {%- assign each_recipient_tag = recipient_choice | split: ': ' | last -%}
          <div class="option-recipent" value="{{ each_recipient_tag }}">
            <span style="display:none"> {{ each_recipient_tag }}:</span>{{ each_recipient }}
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="occasion-container" style="cursor: pointer;">
      <div class="occasion-header">
        <label class="occasion" for="occasion">To Celebrate:</label>
        <button
          type="button"
          id="dropdownButtonOcc"
          style="width:30px; background-color: white; border: none; font-size: 12px; position: absolute;right: 0; cursor: pointer; height: 100%; width: 100%; background-color: transparent;"
        >
          <img
            src="https://cdn.shopify.com/s/files/1/1848/3097/files/arrow-down-sign-to-navigate_1.png?v=1716420225"
            id="dropdownIcon2"
            style="height:17px; width: 17px; cursor: pointer; position: absolute; right: 0; top:0; margin-right: 10px; margin-top:20px;"
          >
        </button>
      </div>
      <input
        type="text"
        id="chosen_input2"
        class="chosen_input2"
        readonly
        style="border: none; width: 50%; padding-left: 10px; font-size: 15px; font-family: poppins;"
      >
      <div
        id="occasion-dropdown"
        class="occasion-dropdown"
        name="occasion"
        style="display: none; position: absolute; top: 60px; border: 1px solid black; z-index: 99"
      >
        {%- assign occasion_choices = section.settings.occasion_choices | split: ', ' -%}
        {% for each_occasion in occasion_choices %}
          <div class="option-occasion" value="{{ each_occasion }}">{{ each_occasion }}</div>
        {% endfor %}
        {% for collection in section.settings.collection_list %}
          <div class="option-occasion" value="{{ each_occasion }}">{{ collection.title }}</div>
        {% endfor %}
      </div>
    </div>

    <div class="budget-container" style="cursor: pointer;">
      <div class="budget-header">
        <label class="budget" for="budget">I'd like to spend:</label>
        <button
          type="button"
          id="dropdownButtonBud"
          style="width:30px; background-color: white; border: none; font-size: 12px; position: absolute;right: 0; cursor: pointer; height: 100%; width: 100%; background-color: transparent;"
        >
          <img
            src="https://cdn.shopify.com/s/files/1/1848/3097/files/arrow-down-sign-to-navigate_1.png?v=1716420225"
            id="dropdownIcon3"
            style="height:17px; width: 17px; cursor: pointer; position: absolute; right: 0; top:0; margin-right: 10px; margin-top:20px;"
          >
        </button>
      </div>
      <input
        type="text"
        id="chosen_input3"
        class="chosen_input3"
        readonly
        style="border: none; width: 50%; padding-left: 10px; font-size: 15px; font-family: poppins;"
        data-recipient-value="100"
      >
      <div
        id="budget-dropdown"
        class="budget-dropdown"
        name="budget"
        style="display: none; position: absolute; top: 60px; border: 1px solid black; z-index: 99"
      >
        {%- assign budget_choices = section.settings.budget_choices | split: ', ' -%}

        {% for budget in budget_choices %}
          {%- assign each_budget = budget | split: ': ' | first -%}
          {%- assign each_budget_tag = budget | split: ': ' | last -%}
          <div class="option-budget" value="{{ each_budget_tag }}">
            <span style="display:none"> {{ each_budget_tag }}:</span>{{ each_budget }}
          </div>
        {% endfor %}
      </div>
    </div>

    <button class="button-style" id="test" onClick="findGift()">FIND YOUR GIFT</button>
  </div>
</div>

<div id="gift-results" class="flex-container">
  {%- capture contentForQuerystring -%}{{ content_for_header }}{%- endcapture -%}
  {%- assign pageUrl = contentForQuerystring
    | split: '"pageurl":"'
    | last
    | split: '"'
    | first
    | split: '.myshopify.com'
    | last
    | replace: '\/', '/'
    | replace: '%20', ' '
    | replace: '\u0026', '&'
  -%}

  {% capture finalurl %}https://{{ pageUrl }}{% endcapture %}
  {% assign recipient_tag = finalurl | split: '?' %}
  {% assign recipient_tag = recipient_tag | last %}
  {% assign recipient_tag = recipient_tag | split: '&' %}
  {% assign recipient_tag = recipient_tag | first %}
  {% assign recipient_tag = recipient_tag | split: '=' %}
  {% assign recipient_tag = recipient_tag | last %}
  {% assign recipient_tag = recipient_tag | split: '%3A+' %}
  {% assign recipient_tag = recipient_tag | last %}
  {% assign recipient_tag = recipient_tag | strip %}

  {% capture finalurl %}https://{{ pageUrl }}{% endcapture %}
  {% assign occasion_tag = finalurl | split: '?' %}
  {% assign occasion_tag = occasion_tag | last %}
  {% assign occasion_tag = occasion_tag | split: '&' %}
  {% assign occasion_tag = occasion_tag[1] %}
  {% assign occasion_tag = occasion_tag | split: '=' %}
  {% assign occasion_tag = occasion_tag | last | strip %}

  {% if occasion_tag == null %}
    {% assign occasion_tag = '' %}
  {% endif %}

  {% capture finalurl %}https://{{ pageUrl }}{% endcapture %}
  {% assign price_tag = finalurl | split: '?' %}
  {% assign price_tag = price_tag | last %}
  {% assign price_tag = price_tag | split: '&' %}
  {% assign price_tag = price_tag[2] %}
  {% assign price_tag = price_tag | split: '=' %}
  {% assign price_tag = price_tag | last %}
  {% assign price_tag = price_tag | split: '$' %}
  {% assign price_tag = price_tag | last %}

  {% capture finalurl %}https://{{ pageUrl }}{% endcapture %}
  {% assign page_tag = finalurl | split: '?' %}
  {% assign page_tag = page_tag | last %}
  {% assign page_tag = page_tag | split: '&' %}
  {% assign page_tag = page_tag | last %}
  {% assign page_tag = page_tag | split: '=' %}
  {% assign page_tag = page_tag | last %}
  {% assign page_tag = page_tag | times: 1 %}

  {% assign price_to_num = price_tag | times: 1 %}

  {% assign limit_value = section.settings.products_to_show %}
  {% if page_tag == 2 %}
    {% assign limit_value = 20 %}
  {% endif %}

{% assign product_handles = '' %}
{% assign product_to_display = 0 %}


  {% if occasion_tag contains 'null' %}
      {% for product in collections.all.products %}
        {% if product.tags contains recipient_tag %}
          {% if product.price < price_to_num %}
            {% capture product_handle %}{{ product.handle }}{% endcapture %}
            {% assign product_handles = product_handles | append: product_handle | append: ',' %}
              {% assign product_to_display = product_to_display | plus: 1 %}
          {% endif %}
        {% endif %}
      {% endfor %}
  {% endif %}
  

  {% if occasion_tag contains 'null' %}
    {% assign product_handles = product_handles | split: ',' %}
    {% for product_handle in product_handles limit: limit_value %}
      <a href="{{ all_products[product_handle].url }}" style="text-decoration: none; color: inherit;">
      <div class="item-container" style="display: flex; justify-content: space-between; flex-direction: column;">
          <div class="div1" style="display: flex; justify-content: center; flex-direction: column;">
            <div class="image-container">
              <div class="image-wrapper">
                {{
                  all_products[product_handle].featured_image
                  | img_url: '350x350'
                  | img_tag: all_products[product_handle].featured_image.alt
                }}
              </div>
            </div>
            <div style="margin-top: 17px; font-weight: bold;">
              {{ all_products[product_handle].title }}
            </div>
            <div style="margin-top: 17px; font-weight: bold;">
              {% if all_products[product_handle].compare_at_price > all_products[product_handle].price %}
                <span style="text-decoration: line-through;">
                  {{- all_products[product_handle].compare_at_price | money -}}
                </span>
                <span style="font-weight: bold; padding-left: 10px;">
                  {{- all_products[product_handle].price | money -}}
                </span>
              {% else %}
                <span style="font-weight: bold;">{{ all_products[product_handle].price | money }}</span>
              {% endif %}
            </div>
          </div>
          <div class="div2" style="padding-bottom: 1px;">
                {%- liquid
                  assign product_form_id = 'quick-add-' | append: section_id | append: all_products[product_handle].id
                  assign qty_rules = false
                  if all_products[product_handle].selected_or_first_available_variant.quantity_rule.min > 1 or all_products[product_handle].selected_or_first_available_variant.quantity_rule.max != null or all_products[product_handle].selected_or_first_available_variant.quantity_rule.increment > 1
                    assign qty_rules = true
                  endif
                -%}
                {%- if all_products[product_handle].variants.size > 1 or qty_rules -%}
                  <a style="text-decoration: none;" href="{{ all_products[product_handle].url }}"
                    ><button class="quick-add__submit button button--full-width button--secondary">ORDER NOW</button></a
                  >
                {%- else -%}
                  {%- if all_products[product_handle].tags contains 'Custom' -%}
                    <a style="text-decoration: none;" href="{{ all_products[product_handle].url }}"
                      ><button class="quick-add__submit button button--full-width button--secondary">
                        ORDER NOW
                      </button></a
                    >
                  {%- else -%}
                    <product-form data-section-id="{{ section.id }}">
                      {%- form 'product',
                        all_products[product_handle],
                        id: product_form_id,
                        class: 'form',
                        novalidate: 'novalidate',
                        data-type: 'add-to-cart-form'
                      -%}
                        <input
                          type="hidden"
                          name="id"
                          value="{{ all_products[product_handle].selected_or_first_available_variant.id }}"
                          class="product-variant-id"
                          {% if all_products[product_handle].selected_or_first_available_variant.available == false %}
                            disabled
                          {% endif %}
                        >
                        <button
                          id="{{ product_form_id }}-submit"
                          type="submit"
                          name="add"
                          class="quick-add__submit button button--full-width button--secondary{% if horizontal_quick_add %} card--horizontal__quick-add{% endif %}"
                          aria-haspopup="dialog"
                          aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ all_products[product_handle].id }}"
                          aria-live="polite"
                          data-sold-out-message="true"
                          {% if all_products[product_handle].selected_or_first_available_variant.available == false %}
                            disabled
                          {% endif %}
                        >
                          <span>
                            {%- if all_products[product_handle].selected_or_first_available_variant.available -%}
                              {{ 'products.product.add_to_cart' | t }}
                            {%- else -%}
                              {{ 'products.product.sold_out' | t }}
                            {%- endif -%}
                          </span>
                          <span class="sold-out-message hidden">
                            {{ 'products.product.sold_out' | t }}
                          </span>
                          {%- if horizontal_quick_add -%}
                            <span class="icon-wrap">{% render 'icon-plus' %}</span>
                          {%- endif -%}
                          {%- render 'loading-spinner' -%}
                        </button>
                      {%- endform -%}
                    </product-form>
                  {%- endif -%}
                {%- endif -%}
            </div>
      </div>
    </a>
    {% endfor %}
  {% else %}
    {% paginate section.settings.collection_list by 1000 %}
      {% for collection in section.settings.collection_list limit: limit_value %}
        {%- if collection.title == occasion_tag %}
          {% for product in collection.products  %}
            {% if product.price < price_to_num %}
              <a href="{{ product.url }}" style="text-decoration: none; color: inherit;">
              {% capture product_ids %}{{ product.id }},{% endcapture %}
              <div class="item-container" style="display: flex; justify-content: space-between; flex-direction: column;">
                  <div class="div1" style="display: flex; justify-content: center; flex-direction: column;">
                    <div class="image-container">
                      <div class="image-wrapper">
                        {{ product.featured_image | img_url: '350x350' | img_tag: product.featured_image.alt }}
                      </div>
                    </div>
                    <div style="margin-top: 17px; font-weight: bold;">
                      {{ product.title }}
                    </div>
                    <div style="margin-top: 17px; font-weight: bold;">
                      {% if product.compare_at_price > product.price %}
                        <span style="text-decoration: line-through;">{{ product.compare_at_price | money }}</span>
                        <span style="font-weight: bold; padding-left: 10px;">{{ product.price | money }}</span>
                      {% else %}
                        <span style="font-weight: bold;">{{ product.price | money }}</span>
                      {% endif %}
                    </div>
                  </div>
                  <div class="div2">
                        {%- liquid
                          assign product_form_id = 'quick-add-' | append: section_id | append: product.id
                          assign qty_rules = false
                          if product.selected_or_first_available_variant.quantity_rule.min > 1 or product.selected_or_first_available_variant.quantity_rule.max != null or product.selected_or_first_available_variant.quantity_rule.increment > 1
                            assign qty_rules = true
                          endif
                        -%}
                        {%- if product.variants.size > 1 or qty_rules -%}
                          <a style="text-decoration: none;" href="{{ product.url }}"
                            ><button class="quick-add__submit button button--full-width button--secondary">
                              ORDER NOW
                            </button></a
                          >
                        {%- else -%}
                          {%- if product.tags contains 'Custom' -%}
                            <a style="text-decoration: none;" href="{{ product.url }}"
                              ><button class="quick-add__submit button button--full-width button--secondary">
                                ORDER NOW
                              </button></a
                            >
                          {%- else -%}
                            <product-form data-section-id="{{ section.id }}">
                              {%- form 'product',
                                product,
                                id: product_form_id,
                                class: 'form',
                                novalidate: 'novalidate',
                                data-type: 'add-to-cart-form'
                              -%}
                                <input
                                  type="hidden"
                                  name="id"
                                  value="{{ product.selected_or_first_available_variant.id }}"
                                  class="product-variant-id"
                                  {% if product.selected_or_first_available_variant.available == false %}
                                    disabled
                                  {% endif %}
                                >
                                <button
                                  id="{{ product_form_id }}-submit"
                                  type="submit"
                                  name="add"
                                  class="quick-add__submit button button--full-width button--secondary{% if horizontal_quick_add %} card--horizontal__quick-add{% endif %}"
                                  aria-haspopup="dialog"
                                  aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ product.id }}"
                                  aria-live="polite"
                                  data-sold-out-message="true"
                                  {% if product.selected_or_first_available_variant.available == false %}
                                    disabled
                                  {% endif %}
                                >
                                  <span>
                                    {%- if product.selected_or_first_available_variant.available -%}
                                      {{ 'products.product.add_to_cart' | t }}
                                    {%- else -%}
                                      {{ 'products.product.sold_out' | t }}
                                    {%- endif -%}
                                  </span>
                                  <span class="sold-out-message hidden">
                                    {{ 'products.product.sold_out' | t }}
                                  </span>
                                  {%- if horizontal_quick_add -%}
                                    <span class="icon-wrap">{% render 'icon-plus' %}</span>
                                  {%- endif -%}
                                  {%- render 'loading-spinner' -%}
                                </button>
                              {%- endform -%}
                            </product-form>
                          {%- endif -%}
                        {%- endif -%}
                    </div>
              </div>
              </a>
              {% assign product_to_display = product_to_display | plus: 1 %}
            {% endif %}
          {% endfor %}
        {% endif %}
      {% endfor %}
    {% endpaginate %}
  {% endif %}
</div>

{%- if product_to_display > limit_value -%}
  <div style="margin: 20px;">
    <div class="center collection__view-all{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <a
        id="viewAllButton"
        href="{{ section.settings.collection.url }}"
        class="button button button--secondary"
        aria-label="View All"
      >
        {{ 'sections.featured_collection.view_all' | t }}
      </a>
    </div>
{%- endif -%}
{% if section.settings.image_shape == 'arch' %}
  {% render 'mask-arch' %}
{% endif %}

{% comment %}
  {% for product in collections.products %}
    <div class="product">
      <h2>{{ product.title }}</h2>
      <p>{{ product.price | money }}</p>
      <!-- Add more product details as needed -->
    </div>
  {% endfor %}
{% endcomment %}

<script>
      function viewAll() {
        var products_to_show = document.getElementById('products_to_show');
        products_to_show.value=100;
        console.log(products_to_show);
      }

      function findGift() {
      var recipient = document.getElementById('chosen_input1').getAttribute('data-recipient-value');
      var occasion = document.getElementById('chosen_input2').value;
      var budget = document.getElementById('chosen_input3').getAttribute('data-recipient-value');
      var page = 1;
      let randomNum = Math.random();

      var newUrl = String(window.location.href.split('?')[0]).concat(
          "?recipient=", recipient,
          "&occasion=", (occasion.includes("Just Because") || occasion.includes("Thank you") || occasion == "") ? 'null' : occasion,
          "&budget=", budget + '00',
          "&page=", page,
          "&type=", parseInt(randomNum*100)
      );

      window.location.href = newUrl;
  }

  function updateURL(page, url) {
      var urlParams = new URLSearchParams(url.search);
      var recipient = urlParams.get('recipient');
      var occasion = urlParams.get('occasion');
      var budget = urlParams.get('budget');

      var newUrl = String(url.href.split('?')[0]).concat(
          "?recipient=", recipient,
          "&occasion=", occasion,
          "&budget=", budget,
          "&page=", page
      );

      window.location.href = newUrl;
  }


  // Handle clicks on the "View All" button
  var viewAllButton = document.getElementById('viewAllButton');
  if (viewAllButton) {
      viewAllButton.addEventListener('click', function(event) {
          event.preventDefault(); // Prevent default anchor behavior
          var currentUrl = new URL(window.location.href);
          var currentPage = currentUrl.searchParams.get('page') || 1;
          var nextPage = parseInt(currentPage) + 1;
          updateURL(nextPage, currentUrl); // Pass currentUrl to updateURL
      });
  }

        document.addEventListener('DOMContentLoaded', function() {
        const dropdownButtonRec = document.getElementById('dropdownButtonRec');
        const recipientDropdown = document.getElementById('recipient-dropdown');
        const chosenInput1 = document.getElementById('chosen_input1');
        chosenInput1.value = "Her";

        const dropdownButtonOcc = document.getElementById('dropdownButtonOcc');
        const occasionDropdown = document.getElementById('occasion-dropdown');
        const chosenInput2 = document.getElementById('chosen_input2');
        chosenInput2.value = "Just Because";

        const dropdownButtonBud = document.getElementById('dropdownButtonBud');
        const budgetDropdown = document.getElementById('budget-dropdown');
        const chosenInput3 = document.getElementById('chosen_input3');
        chosenInput3.value = "Up to $100";

        const icon1 = document.getElementById('dropdownIcon1');
        const icon2 = document.getElementById('dropdownIcon2');
        const icon3 = document.getElementById('dropdownIcon3');

        const viewAll = document.getElementById('view-all');


        const dropdowns = {
            recipient: { button: dropdownButtonRec, dropdown: recipientDropdown, icon: icon1 },
            occasion: { button: dropdownButtonOcc, dropdown: occasionDropdown, icon: icon2 },
            budget: { button: dropdownButtonBud, dropdown: budgetDropdown, icon: icon3 },
            };

          function closeAllDropdowns() {
            Object.values(dropdowns).forEach(({ dropdown, icon }) => {
            dropdown.style.display = 'none';
            icon.style.transform = 'rotate(0deg)';
        });
      }

        function toggleDropdown1(dropdown, button) {
             if (dropdown.style.display === 'none' || dropdown.style.display === '') {
                closeAllDropdowns();
                dropdown.style.display = 'block';
                icon1.style.transform = 'rotate(180deg)'
            } else {
                dropdown.style.display = 'none';
                icon1.style.transform = 'rotate(0deg)';
            }
        }

          function toggleDropdown2(dropdown, button) {
            if (dropdown.style.display === 'none' || dropdown.style.display === '') {
                closeAllDropdowns();
                dropdown.style.display = 'block';
                icon2.style.transform = 'rotate(180deg)'
            } else {
                dropdown.style.display = 'none';
                icon2.style.transform = 'rotate(0deg)';
            }
        }

          function toggleDropdown3(dropdown, button) {
            if (dropdown.style.display === 'none' || dropdown.style.display === '') {
                closeAllDropdowns();
                dropdown.style.display = 'block';
                icon3.style.transform = 'rotate(180deg)'
            } else {
                dropdown.style.display = 'none';
                icon3.style.transform = 'rotate(0deg)';
            }
        }

        dropdownButtonRec.addEventListener('click', function() {
            toggleDropdown1(recipientDropdown, this);
        });

        dropdownButtonOcc.addEventListener('click', function() {
            toggleDropdown2(occasionDropdown, this);
        });

        dropdownButtonBud.addEventListener('click', function() {
            toggleDropdown3(budgetDropdown, this);
        });

        recipientDropdown.querySelectorAll('.option-recipient').forEach(option => {
            option.addEventListener('click', function() {
                chosenInput1.value = option.textContent;
                recipientDropdown.style.display = 'none';
                icon1.style.transform = 'rotate(0deg)';
            });
        });

        occasionDropdown.querySelectorAll('.option-occasion').forEach(option => {
            option.addEventListener('click', function() {
                chosenInput2.value = option.textContent;
                occasionDropdown.style.display = 'none';
                icon2.style.transform = 'rotate(0deg)';
            });
        });

        budgetDropdown.querySelectorAll('.option-budget').forEach(option => {
            option.addEventListener('click', function() {
                chosenInput3.value = option.textContent;
                budgetDropdown.style.display = 'none';
                icon3.style.transform = 'rotate(0deg)';
            });
        });






        function updateInputAndStoreValue1(dropdown, inputField, dataAttribute, icon) {
          dropdown.querySelectorAll('.option-recipent').forEach(option => {
                  option.addEventListener('click', function() {
                  dropdown.style.display = 'none';
                  icon.style.transform = 'rotate(0deg)';

                  const parts = option.textContent.split(':');
                  if (parts.length === 2) {
                      inputField.value = parts[1].trim();
                      inputField.setAttribute(dataAttribute, parts[0].trim());
                  }
              });
          });
      }

      updateInputAndStoreValue1(recipientDropdown, chosenInput1, 'data-recipient-value', icon1);


       function updateInputAndStoreValue2(dropdown, inputField, dataAttribute, icon) {
          dropdown.querySelectorAll('.option-occasion').forEach(option => {
                  option.addEventListener('click', function() {
                  dropdown.style.display = 'none';
                  icon.style.transform = 'rotate(0deg)';
                  const parts = option.textContent.split(':');
                  if (parts.length === 2) {
                      inputField.value = parts[1].trim();
                      inputField.setAttribute(dataAttribute, parts[0].trim());
                  }
              });
          });
      }

      updateInputAndStoreValue2(occasionDropdown, chosenInput2, 'data-recipient-value', icon2);




      function updateInputAndStoreValue3(dropdown, inputField, dataAttribute, icon) {
          dropdown.querySelectorAll('.option-budget').forEach(option => {
              option.addEventListener('click', function() {
                  const parts = option.textContent.split(':');
                  if (parts.length === 2) {
                      inputField.value = parts[1].trim();
                      inputField.setAttribute(dataAttribute, parts[0].trim());
                  }
                  dropdown.style.display = 'none';
                  icon.style.transform = 'rotate(0deg)';
              });
          });
      }

      updateInputAndStoreValue3(budgetDropdown, chosenInput3, 'data-recipient-value', icon3);

      document.addEventListener('click', function(event) {
      const isClickInsideDropdown = Object.values(dropdowns).some(({ dropdown }) => dropdown.contains(event.target));
      const isClickInsideButton = Object.values(dropdowns).some(({ button }) => button.contains(event.target));

      if (!isClickInsideDropdown && !isClickInsideButton) {
        closeAllDropdowns();
      }
    });

    });
</script>

