{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding" style="background-color: {{ section.settings.background_color }};">
  <div class="justify-center px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 md:gap-[42px]">
      {%- comment -%} Info & Image Column {%- endcomment -%}
      <div class="space-y-8 md:order-last md:w-full md:px-[10px]">
        {% if section.settings.image != blank %}
          <div class="rounded-2xl overflow-hidden">
            <img 
              src="{{ section.settings.image | image_url: width: 1200 }}" 
              alt="{{ section.settings.image.alt | escape }}"
              class="w-full h-full object-cover"
              height=""
              width=""
            >
          </div>
        {% endif %}
        <div class="space-y-6">
          {% if section.settings.hours_heading != blank %}
            <div class="flex items-start gap-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              <div>
                <h3 class="font-bold">{{ section.settings.hours_heading }}</h3>
                <div class="mt-1 rte text-sm">{{ section.settings.hours_content }}</div>
              </div>
            </div>
          {% endif %}
          {% if section.settings.email != blank %}
            <div class="flex items-start gap-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              <div>
                <a href="mailto:{{ section.settings.email }}" class="font-bold hover:underline">{{ section.settings.email }}</a>
              </div>
            </div>
          {% endif %}
          {% if section.settings.phone != blank %}
            <div class="flex items-start gap-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <div>
                <a href="tel:{{ section.settings.phone }}" class="font-bold hover:underline">{{ section.settings.phone }}</a>
              </div>
            </div>
          {% endif %}
        </div>
      </div>
      {%- comment -%} Form Column {%- endcomment -%}
      <div class="mt-12 md:mt-0 md:order-first md:w-full md:px-[10px]">
        {% if section.settings.heading != blank %}
          <h2 class="text-[24px] font-[700] leading-[26px] tracking-[0.325px] text-espresso!">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <div class="mt-4 text-[14px] leading-[18px] tracking-[0.3px] text-espresso font-[500]">{{ section.settings.subheading }}</div>
        {% endif %}
        {%- form 'contact', class: 'mt-8' -%}
          {%- if form.posted_successfully? -%}
            <p class="p-4 bg-green-100 text-green-800 rounded-lg">
              {{ 'templates.contact.form.post_success' | t }}
            </p>
          {%- elsif form.errors -%}
            <div class="p-4 bg-red-100 text-red-800 rounded-lg">
              <p>{{ 'templates.contact.form.error_heading' | t }}</p>
              <ul class="list-disc list-inside">
                {%- for field in form.errors -%}
                  <li>
                    <a href="#ContactForm-{{ field }}" class="underline">
                      {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
          <div class="space-y-4">
            <input type="text" name="contact[First Name]" placeholder="First Name*" class="w-full p-3 border border-espresso rounded-[6px] text-[14px] leading-[18px] tracking-[0.3px] font-[500] text-espresso placeholder:text-espresso bg-[#FFFAF2]">
            <input type="text" name="contact[Last Name]" placeholder="Last Name*" class="w-full p-3 border border-espresso rounded-[6px] text-[14px] leading-[18px] tracking-[0.3px] font-[500] text-espresso placeholder:text-espresso bg-[#FFFAF2]">
            <input type="email" name="contact[email]" placeholder="Email*" class="w-full p-3 border border-espresso rounded-[6px] text-[14px] leading-[18px] tracking-[0.3px] font-[500] text-espresso placeholder:text-espresso bg-[#FFFAF2]">
            <input type="tel" name="contact[phone]" placeholder="Phone*" class="w-full p-3 border border-espresso rounded-[6px] text-[14px] leading-[18px] tracking-[0.3px] font-[500] text-espresso placeholder:text-espresso bg-[#FFFAF2]">
            <textarea name="contact[body]" placeholder="Message..." rows="6" class="w-full p-3 border border-espresso rounded-[6px] text-[14px] leading-[18px] tracking-[0.3px] font-[500] text-espresso placeholder:text-espresso bg-[#FFFAF2]"></textarea>
            <button type="submit" class="p-[16px] text-white uppercase text-[18px] tracking-[0.75px] leading-[18px] font-[800] bg-popsugar rounded-[6px] hover:bg-ppopsugar">
              {{ section.settings.button_text }}
            </button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Page - Contact Us",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFFAF2"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in touch with the team"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Fill in the form below and we'll get back to you as soon as we can. Alternatively, you can call us on 9077 4542 from 9am to 4pm Melbourne time on weekdays, or from 9am to 2pm on Saturdays.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Contact Us"
    },
    {
      "type": "header",
      "content": "Info Column"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "hours_heading",
      "label": "Hours Heading",
      "default": "Office Hours"
    },
    {
      "type": "richtext",
      "id": "hours_content",
      "label": "Hours Content",
      "default": "<p>Monday - Friday: 9:00am - 4:00pm<br>Saturday: 9:00am - 2:00pm<br>Sunday: Closed</p>"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email Address",
      "default": "service@cupcakecentral.com.au"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone Number",
      "default": "(03) 9077 4542"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 60 }
  ],
  "presets": [
    {
      "name": "Page - Contact Us"
    }
  ]
}
{% endschema %}