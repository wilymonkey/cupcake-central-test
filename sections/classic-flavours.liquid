{% comment %}
  Classic Flavours Section with Swiper Slider and Hover Images
{% endcomment %}

{% if section.settings.mobile_layout == 'slider' or section.settings.desktop_layout == 'slider' %}
  {{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
  {{ 'swiper-bundle.min.js' | asset_url | script_tag }}
{% endif %}

<style>
  #shopify-section-{{ section.id }} .classic-flavours-section {
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }
  
  #shopify-section-{{ section.id }} .flavour-card {
    background-color: {{ section.settings.card_background }};
    border-radius: {{ section.settings.card_border_radius }}px;
    position: relative;
    overflow: hidden;
  }
  
  #shopify-section-{{ section.id }} .flavour-title {
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_font_size }}px;
  }
  
  #shopify-section-{{ section.id }} .flavour-description {
    color: {{ section.settings.description_color }};
    font-size: {{ section.settings.description_font_size }}px;
  }
  
  #shopify-section-{{ section.id }} .flavour-image-container {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  
  #shopify-section-{{ section.id }} .flavour-image {
    width: 100%;
    transition: opacity 0.3s ease-in-out;
  }
  
  #shopify-section-{{ section.id }} .flavour-image-hover {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }
  
  #shopify-section-{{ section.id }} .flavour-card:hover .flavour-image-default {
    opacity: 0;
  }
  
  #shopify-section-{{ section.id }} .flavour-card:hover .flavour-image-hover {
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .flavour-title-link,
  #shopify-section-{{ section.id }} .flavour-image-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  #shopify-section-{{ section.id }} .flavour-title-link:hover {
    text-decoration: underline;
  }

  #shopify-section-{{ section.id }} .flavour-image-link {
    cursor: pointer;
  }
  
  /* Layout containers - hidden by default */
  #shopify-section-{{ section.id }} .mobile-slider-container,
  #shopify-section-{{ section.id }} .desktop-slider-container,
  #shopify-section-{{ section.id }} .grid-container {
    display: none;
  }

  @media (max-width: 1023px) {
    .vegan-flavours-section .swiper-pagination{
      height: 2px;
    }
    .vegan-flavours-section .swiper-pagination-progressbar-fill{
      height: 4px;
      background: #840000 !important;
      top: -1px;
    }
    .vegan-flavours-section .swiper-navigation-icon{
      color: #FFFFFF !important;
    }
    .vegan-flavours-section .swiper-button-next, .vegan-flavours-section .swiper-button-prev{
      background: #840000 !important;
    }
    .vegan-flavours-section .swiper-button-disabled{
      background: #FFFFFF !important;
      border: 1px solid #840000;
      opacity: 1;
      color: #840000 !important;
    }
    .vegan-flavours-section .swiper-button-disabled .swiper-navigation-icon{
      color: #840000 !important;
    }
  }
  
  .classic-flavours-section .swiper-pagination-progressbar-fill{
    background: #FFFFFF;
  }

  .classic-flavours-section .swiper-button-disabled{
    color: #FFFFFF !important;
    opacity: 1 !important;
    background: transparent !important;
  }
  
  .classic-flavours-section .swiper-button-disabled .swiper-navigation-icon{
    color:#FFFFFF;
  }
  
  .classic-flavours-section .swiper-navigation-icon{
    color:#2E1A16;
  }

  /* Mobile layout display */
  {% if section.settings.mobile_layout == 'slider' %}
    @media (max-width: 1023px) {
      #shopify-section-{{ section.id }} .mobile-slider-container {
        display: block;
      }
    }
  {% else %}
    @media (max-width: 1023px) {
      #shopify-section-{{ section.id }} .grid-container {
        display: grid;
        grid-template-columns: repeat(1, 1fr);
        gap: 20px;
      }
    }
    
    @media (min-width: 768px) and (max-width: 1023px) {
      #shopify-section-{{ section.id }} .grid-container {
        grid-template-columns: repeat(2, 1fr);
      }
    }
  {% endif %}
  
  /* Desktop layout display */
  {% if section.settings.desktop_layout == 'slider' %}
    @media (min-width: 1024px) {
      #shopify-section-{{ section.id }} .desktop-slider-container {
        display: block;
      }
    }
  {% else %}
    @media (min-width: 1024px) {
      #shopify-section-{{ section.id }} .grid-container {
        display: grid;
        grid-template-columns: repeat({{ section.settings.grid_columns }}, 1fr);
        gap: 20px;
      }
    }
  {% endif %}

  @media (min-width: 768px) and (max-width: 1023px) {
    .vegan-flavours-section.pr-0{
      padding-right: 0 !important;
    }
  }
  
  /* Button color classes */
  #shopify-section-{{ section.id }} .btn-red { background-color: #DC2626; }
  #shopify-section-{{ section.id }} .btn-blue { background-color: #2563EB; }
  #shopify-section-{{ section.id }} .btn-green { background-color: #16A34A; }
  #shopify-section-{{ section.id }} .btn-purple { background-color: #9333EA; }
  #shopify-section-{{ section.id }} .btn-pink { background-color: #DB2777; }
  #shopify-section-{{ section.id }} .btn-indigo { background-color: #4F46E5; }
</style>

{% if section.settings.desktop_layout == 'slider' %}
<section class="classic-flavours-section py-16 pl-40 md:pd {{ section.settings.section_class_name }}">
{% else %}
<section class="classic-flavours-section py-16 pl-40 pr-0 pr-40 md:pd {{ section.settings.section_class_name }}">
{% endif %}
    {% if section.settings.heading != blank %}
      <div class="text-4xl md:text-5xl text-center mb-12 text-[24px] d-sm:text-[36px] d-sm:leading-[33px]! font-black leading-[22px]! tracking-normal!" style="color: {{ section.settings.heading_color }};">{{ section.settings.heading }}</div>
    {% endif %}
    
    {% if section.settings.description != blank %}
      <div class="text-center max-w-3xl mx-auto mb-12 max-w-[352px] md:max-w-[490px] d-sm:max-w-[600px] mx-auto py-5 text-center px-[24px] d-sm:px-0 text-[14px]! font-[500] leading-[18px]! d-sm:py-5 md:pt-3 md:pb-1 d-lg:pt-4 d-lg:pb-1 d-sm:text-[24px] d-sm:leading-[34px]">
        <p class="text-lg text-[14px]! d-sm:text-[16px]! font-[500] leading-[18px]! d-sm:leading-[23px]! tracking-[0.3px]">{{ section.settings.description }}</p>
      </div>
    {% endif %}

    <!-- Mobile Slider Layout -->
    {% if section.settings.mobile_layout == 'slider' %}
      <div class="mobile-slider-container swiper classicFlavoursMobileSwiper mt-30 pr-40 py-40">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            <div class="swiper-slide">
              <div class="flavour-card h-full flex flex-col shadow-lg">
                <div class="p-6 h-[128px]">
                  {% if block.settings.title != blank %}
                    {% if block.settings.title_link != blank %}
                      <a href="{{ block.settings.title_link }}" class="flavour-title-link">
                        <h3 class="flavour-title text-2xl font-bold mb-3 text-center">{{ block.settings.title }}</h3>
                      </a>
                    {% else %}
                      <h3 class="flavour-title text-2xl font-bold mb-3 text-center">{{ block.settings.title }}</h3>
                    {% endif %}
                  {% endif %}
                  
                  {% if block.settings.description != blank %}
                    <p class="flavour-description mb-4 flex-grow text-center">{{ block.settings.description }}</p>
                  {% endif %}
                </div>
                
                {% if block.settings.image != blank or block.settings.hover_image != blank %}
                  <div class="flavour-image-container">
                    {% if block.settings.image_link != blank %}
                      <a href="{{ block.settings.image_link }}" class="flavour-image-link">
                    {% endif %}
                    
                    {% if block.settings.image != blank %}
                      <img 
                        src="{{ block.settings.image | img_url: '500x' }}" 
                        alt="{{ block.settings.image.alt | escape }}" 
                        class="flavour-image flavour-image-default"
                        loading="lazy"
                        width="500"
                        height="300"
                      >
                    {% else %}
                      <div class="flavour-image flavour-image-default bg-gray-200 rounded-lg flex items-center justify-center h-64">
                        <span class="text-gray-500">Default Image</span>
                      </div>
                    {% endif %}
                    
                    {% if block.settings.hover_image != blank %}
                      <img 
                        src="{{ block.settings.hover_image | img_url: '500x' }}" 
                        alt="{{ block.settings.hover_image.alt | escape }}" 
                        class="flavour-image flavour-image-hover"
                        loading="lazy"
                        width="500"
                        height="300"
                      >
                    {% else %}
                      <div class="flavour-image flavour-image-hover bg-gray-300 rounded-lg flex items-center justify-center h-64">
                        <span class="text-gray-600">Hover Image</span>
                      </div>
                    {% endif %}
                    
                    {% if block.settings.image_link != blank %}
                      </a>
                    {% endif %}
                  </div>
                {% endif %}
                
                {% if block.settings.button_text != blank %}
                  <a 
                    href="{{ block.settings.button_link }}" 
                    class="btn-{{ section.settings.button_color }} inline-block mt-auto px-6 py-3 text-white font-medium rounded-md hover:opacity-90 transition-opacity"
                  >
                    {{ block.settings.button_text }}
                  </a>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
        
        <div class="swiper-pagination position-unset mt-30 progressbar-bg-color"></div>
        <div class="md:flex pt-[20px] flex justify-center md:justify-center md:items-start md:gap-[40px] d-lg:gap-[60px] gap-20 mt-30">
          <div class="swiper-button-prev position-unset p-[5px] border-1 bg-[#ffffff] rounded-[6px] w-[30px]! h-[30px]!"></div>
          <div class="swiper-button-next position-unset p-[5px] border-1 bg-[#ffffff] rounded-[6px] w-[30px]! h-[30px]!"></div>
        </div>
      </div>
    {% endif %}

    <!-- Desktop Slider Layout -->
    {% if section.settings.desktop_layout == 'slider' %}
      <div class="desktop-slider-container swiper classicFlavoursDesktopSwiper mt-30 pr-40 py-40">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            <div class="swiper-slide">
              <div class="flavour-card h-full flex flex-col shadow-lg">
                <div class="p-6 h-[128px]">
                  {% if block.settings.title != blank %}
                    {% if block.settings.title_link != blank %}
                      <a href="{{ block.settings.title_link }}" class="flavour-title-link">
                        <h3 class="flavour-title text-2xl font-bold mb-3 text-center">{{ block.settings.title }}</h3>
                      </a>
                    {% else %}
                      <h3 class="flavour-title text-2xl font-bold mb-3 text-center">{{ block.settings.title }}</h3>
                    {% endif %}
                  {% endif %}
                  
                  {% if block.settings.description != blank %}
                    <p class="flavour-description mb-4 flex-grow text-center">{{ block.settings.description }}</p>
                  {% endif %}
                </div>
                
                {% if block.settings.image != blank or block.settings.hover_image != blank %}
                  <div class="flavour-image-container">
                    {% if block.settings.image_link != blank %}
                      <a href="{{ block.settings.image_link }}" class="flavour-image-link">
                    {% endif %}
                    
                    {% if block.settings.image != blank %}
                      <img 
                        src="{{ block.settings.image | img_url: '500x' }}" 
                        alt="{{ block.settings.image.alt | escape }}" 
                        class="flavour-image flavour-image-default"
                        loading="lazy"
                        width="500"
                        height="300"
                      >
                    {% else %}
                      <div class="flavour-image flavour-image-default bg-gray-200 rounded-lg flex items-center justify-center h-64">
                        <span class="text-gray-500">Default Image</span>
                      </div>
                    {% endif %}
                    
                    {% if block.settings.hover_image != blank %}
                      <img 
                        src="{{ block.settings.hover_image | img_url: '500x' }}" 
                        alt="{{ block.settings.hover_image.alt | escape }}" 
                        class="flavour-image flavour-image-hover"
                        loading="lazy"
                        width="500"
                        height="300"
                      >
                    {% else %}
                      <div class="flavour-image flavour-image-hover bg-gray-300 rounded-lg flex items-center justify-center h-64">
                        <span class="text-gray-600">Hover Image</span>
                      </div>
                    {% endif %}
                    
                    {% if block.settings.image_link != blank %}
                      </a>
                    {% endif %}
                  </div>
                {% endif %}
                
                {% if block.settings.button_text != blank %}
                  <a 
                    href="{{ block.settings.button_link }}" 
                    class="btn-{{ section.settings.button_color }} inline-block mt-auto px-6 py-3 text-white font-medium rounded-md hover:opacity-90 transition-opacity"
                  >
                    {{ block.settings.button_text }}
                  </a>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
        
        <div class="swiper-pagination position-unset mt-30 progressbar-bg-color"></div>
        <div class="md:flex pt-[20px] flex justify-center md:justify-center md:items-start md:gap-[40px] d-lg:gap-[60px] gap-20 mt-30">
          <div class="swiper-button-prev position-unset p-[5px] border-1 bg-[#ffffff] rounded-[6px] w-[30px]! h-[30px]!"></div>
          <div class="swiper-button-next position-unset p-[5px] border-1 bg-[#ffffff] rounded-[6px] w-[30px]! h-[30px]!"></div>
        </div>
      </div>
    {% endif %}

    <!-- Grid Layout -->
    <div class="grid-container mt-30">
      {% for block in section.blocks %}
        <div class="flavour-card flex flex-col shadow-lg">
          <div class="p-6 h-[128px]">
            {% if block.settings.title != blank %}
              {% if block.settings.title_link != blank %}
                <a href="{{ block.settings.title_link }}" class="flavour-title-link no-underline">
                  <h3 class="flavour-title text-2xl font-bold mb-3 text-center">{{ block.settings.title }}</h3>
                </a>
              {% else %}
                <h3 class="flavour-title text-2xl font-bold mb-3 text-center">{{ block.settings.title }}</h3>
              {% endif %}
            {% endif %}
            
            {% if block.settings.description != blank %}
              <p class="flavour-description mb-4 flex-grow text-center">{{ block.settings.description }}</p>
            {% endif %}
          </div>
          
          {% if block.settings.image != blank or block.settings.hover_image != blank %}
            <div class="flavour-image-container">
              {% if block.settings.image_link != blank %}
                <a href="{{ block.settings.image_link }}" class="flavour-image-link">
              {% endif %}
              
              {% if block.settings.image != blank %}
                <img 
                  src="{{ block.settings.image | img_url: '500x' }}" 
                  alt="{{ block.settings.image.alt | escape }}" 
                  class="flavour-image flavour-image-default"
                  loading="lazy"
                  width="500"
                  height="300"
                >
              {% else %}
                <div class="flavour-image flavour-image-default bg-gray-200 rounded-lg flex items-center justify-center h-64">
                  <span class="text-gray-500">Default Image</span>
                </div>
              {% endif %}
              
              {% if block.settings.hover_image != blank %}
                <img 
                  src="{{ block.settings.hover_image | img_url: '500x' }}" 
                  alt="{{ block.settings.hover_image.alt | escape }}" 
                  class="flavour-image flavour-image-hover"
                  loading="lazy"
                  width="500"
                  height="300"
                >
              {% else %}
                <div class="flavour-image flavour-image-hover bg-gray-300 rounded-lg flex items-center justify-center h-64">
                  <span class="text-gray-600">Hover Image</span>
                </div>
              {% endif %}
              
              {% if block.settings.image_link != blank %}
                </a>
              {% endif %}
            </div>
          {% endif %}
          
          {% if block.settings.button_text != blank %}
            <a 
              href="{{ block.settings.button_link }}" 
              class="btn-{{ section.settings.button_color }} inline-block mt-auto px-6 py-3 text-white font-medium rounded-md hover:opacity-90 transition-opacity"
            >
              {{ block.settings.button_text }}
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", function() {
  // Initialize mobile slider only if mobile layout is set to slider
  {% if section.settings.mobile_layout == 'slider' %}
    const mobileSwiperElement = document.querySelector('#shopify-section-{{ section.id }} .classicFlavoursMobileSwiper');
    if (mobileSwiperElement && window.innerWidth < 1024) {
      new Swiper(mobileSwiperElement, {
        slidesPerView: 1,
        spaceBetween: 20,
        loop: false,
        pagination: {
          el: mobileSwiperElement.querySelector('.swiper-pagination'),
          type: "progressbar",
          clickable: true
        },
        navigation: {
          nextEl: mobileSwiperElement.querySelector('.swiper-button-next'),
          prevEl: mobileSwiperElement.querySelector('.swiper-button-prev')
        },
        breakpoints: {
          640: {
            slidesPerView: 2,
            spaceBetween: 20
          },
          768: {
            slidesPerView: 2.5,
            spaceBetween: 20
          }
        }
      });
    }
  {% endif %}

  // Initialize desktop slider only if desktop layout is set to slider
  {% if section.settings.desktop_layout == 'slider' %}
    const desktopSwiperElement = document.querySelector('#shopify-section-{{ section.id }} .classicFlavoursDesktopSwiper');
    if (desktopSwiperElement && window.innerWidth >= 1024) {
      new Swiper(desktopSwiperElement, {
        slidesPerView: 1,
        spaceBetween: 20,
        loop: false,
        pagination: {
          el: desktopSwiperElement.querySelector('.swiper-pagination'),
          type: "progressbar",
          clickable: true
        },
        navigation: {
          nextEl: desktopSwiperElement.querySelector('.swiper-button-next'),
          prevEl: desktopSwiperElement.querySelector('.swiper-button-prev')
        },
        breakpoints: {
          1024: {
            slidesPerView: 4.3,
            spaceBetween: 30
          }
        }
      });
    }
  {% endif %}
});
</script>

{% schema %}
{
  "name": "Classic Flavours",
  "settings": [
    {
      "type": "text",
      "id": "section_class_name",
      "label": "Section Custom Class Name",
      "info": "Add a custom CSS class for the entire section",
      "default": "custom-classic-flavours"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Desktop Layout",
      "options": [
        {
          "value": "slider",
          "label": "Slider"
        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ],
      "default": "slider"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile Layout",
      "options": [
        {
          "value": "slider",
          "label": "Slider"
        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ],
      "default": "slider"
    },
    {
      "type": "range",
      "id": "grid_columns",
      "label": "Grid Columns (Desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "info": "Only applies to desktop grid layout"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CLASSIC FLAVOURS"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#FFFFFF"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "In rhoncus tells and studies fermentum. Pellentesque aget odio vitae turgis molestudia feugiat at."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card Background Color",
      "default": "#F8F8F8"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card Border Radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#1F2937"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Title Font Size",
      "min": 16,
      "max": 32,
      "step": 1,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#6B7280"
    },
    {
      "type": "range",
      "id": "description_font_size",
      "label": "Description Font Size",
      "min": 12,
      "max": 20,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "button_color",
      "label": "Button Color",
      "options": [
        {
          "value": "red",
          "label": "Red"
        },
        {
          "value": "blue",
          "label": "Blue"
        },
        {
          "value": "green",
          "label": "Green"
        },
        {
          "value": "purple",
          "label": "Purple"
        },
        {
          "value": "pink",
          "label": "Pink"
        },
        {
          "value": "indigo",
          "label": "Indigo"
        }
      ],
      "default": "red"
    }
  ],
  "blocks": [
    {
      "type": "flavour",
      "name": "Flavour",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Default Image"
        },
        {
          "type": "image_picker",
          "id": "hover_image",
          "label": "Hover Image",
          "info": "This image will appear when hovering over the card"
        },
        {
          "type": "url",
          "id": "image_link",
          "label": "Image Link",
          "info": "Optional link for the entire image area"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Flavour Name"
        },
        {
          "type": "url",
          "id": "title_link",
          "label": "Title Link",
          "info": "Optional link for the flavour title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Flavour description goes here."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Classic Flavours",
      "category": "Custom Sections",
      "settings": {
        "desktop_layout": "slider",
        "mobile_layout": "slider",
        "section_class_name": "custom-classic-flavours"
      },
      "blocks": [
        {
          "type": "flavour",
          "settings": {
            "title": "SANTA CLAUS",
            "description": "A festive blend of peppermint and chocolate.",
            "button_text": "Shop Now"
          }
        },
        {
          "type": "flavour",
          "settings": {
