{% schema %}
{
  "name": "Image Gallery",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Image 4"
    },
    {
      "type": "image_picker",
      "id": "image_5",
      "label": "Image 5"
    }
  ],
  "presets": [
    {
      "name": "Image Gallery",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<section class="image-gallery">
  <div class="gallery-container">
    {% for i in (1..5) %}
      {% assign image_var = 'image_' | append: i %}
      {% if section.settings[image_var] %}
        <div class="gallery-item">
          <img src="{{ section.settings[image_var] | img_url: '800x' }}" alt="Gallery Image {{ i }}">
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

<style>
.image-gallery {
  padding: 0px;
}

.gallery-container {
  display: flex;
  justify-content: center;
  max-width: 100%;
}

.gallery-item {
  flex: 1 1 calc(33.33% - 10px); /* Default: 3 columns */
  max-width: calc(33.33% - 10px);
}

.gallery-item img {
  width: 100%;
  height: 250px;
  object-fit: cover;
  border-radius: 0px;
}

/* Mobile Layout (2x3 Grid) */
@media (max-width: 768px) {
  .gallery-container {
    display: grid;
    grid-template-columns: repeat(2, 1fr); /* 2 columns */
    grid-template-rows: auto;
    gap: 10px;
  }

  .gallery-item {
    width: 100%;
    max-width: none;
  }
  .image-gallery {
  padding: 0px;
}

  .gallery-item img {
  width: 100%;
  height: 200px;
  object-fit: cover;
  border-radius: 0px;
}

.gallery-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0px;
  max-width: 100%;
}
}
</style>