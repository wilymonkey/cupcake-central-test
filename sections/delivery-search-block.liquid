<div class="delivery-search-block page-width">
  <!-- Background Map -->
  <div id="map"></div>

  <!-- Main Content -->
  <div class="delivery-content-block delivery-content-postcode-not-searched">
    <h1 class="uppercase">Search and see if we deliver to your area</h1>
  </div>

  <div class="delivery-content-block delivery-content-postcode-found">
    <div class="postcode-found-container">
      <div class="postcode-found-container-1">
        <h1 class="uppercase" style="text-align: right;">{{ section.settings['title-line1'] }}</h1>
        <span class="uppercase" style="color: #1b9a8e; text-align: left; padding-left: 10px;">
          {{ section.settings['title-line2'] }}
        </span>
        <span>
          <img
            class="delivery-image"
            src="{{ section.settings.image2 | img_url: 'master' }}"
            alt="delivery Image"
          >
        </span>
      </div>
    </div>
  </div>

  <div class="delivery-content-block delivery-content-postcode-not-found">
    <h1 class="uppercase" style="text-align: left;">{{ section.settings['title-delivery-false'] }}</h1>
    <p style="font-weight: 200 !important; font-size: 14px; line-height: 19px; margin-bottom: 10px;">
      However, please give us a call on 0390774542, and we might be able to arrange something for you. <br/>
      Scroll down to view all the Postcodes and suburbs we deliver to.
    </p>
    <a href="https://cupcakecentral.com.au/collections/national-shipping">
    <button class="aus-wide-button"> AUS WIDE</button>
    </a>
  </div>

  <div
    class="search-container scroll-trigger animate--slide-in"
    data-cascade=""
    style="--animation-order: 0;"
  > 
    <div class="footer-block__newsletter search-block">
      <form id="hf-delivery-checker-form" class="fit-to-parent">
        <p>Enter postcode to see if we can deliver to you.</p>
          <input class="hf-delivery-checker-input1" id="hf-delivery-checker-input" type="text" placeholder="Enter your postcode...">
        <button
    type="submit"
    class="delivery-checker-btn search-button"
    onclick="handlePostcodeCheckerSubmit(event);return false;"
  >
          SEARCH
        </button>
      </form>
    </div>
  </div>
</div>
