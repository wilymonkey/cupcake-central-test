  // Handle postcode or suburb search
  document.getElementById("hf-delivery-checker-form").addEventListener("submit", (event) => {
    event.preventDefault(); // Prevent form submission

    const input = document.getElementById("hf-delivery-checker-input").value.trim();

    if (!input) {
      alert("Please enter a postcode or suburb.");
      return;
    }

    // Check if the input is a postcode
    if (postcodeCoordinates[input]) {
      const location = postcodeCoordinates[input];
      map.setCenter({ lat: location.lat, lng: location.lng });
      map.setZoom(14);

      // Place the marker on the map
      if (marker) {
        marker.setMap(null); // Remove the previous marker, if any
      }
      marker = new google.maps.Marker({
        position: { lat: location.lat, lng: location.lng },
        map: map,
        title: `Postcode: ${input}, Suburb: ${location.suburb}`,
      });

      console.log(`Found postcode: ${input}, Suburb: ${location.suburb}`);
      return;
    }

    // Check if the input is a suburb
    const foundPostcode = Object.keys(postcodeCoordinates).find(
      (postcode) => postcodeCoordinates[postcode].suburb.toLowerCase() === input.toLowerCase()
    );

    if (foundPostcode) {
      const location = postcodeCoordinates[foundPostcode];
      map.setCenter({ lat: location.lat, lng: location.lng });
      map.setZoom(14);

      // Place the marker on the map
      if (marker) {
        marker.setMap(null); // Remove the previous marker, if any
      }
      marker = new google.maps.Marker({
        position: { lat: location.lat, lng: location.lng },
        map: map,
        title: `Postcode: ${foundPostcode}, Suburb: ${location.suburb}`,
      });

      console.log(`Found suburb: ${location.suburb}, Postcode: ${foundPostcode}`);
      return;
    }

    // If no match is found, use geocoding as a fallback
    geocoder.geocode({ address: input }, (results, status) => {
      if (status === google.maps.GeocoderStatus.OK) {
        const location = results[0].geometry.location;
        map.setCenter(location);
        map.setZoom(14);

        // Place the marker on the map
        if (marker) {
          marker.setMap(null); // Remove the previous marker, if any
        }
        marker = new google.maps.Marker({
          position: location,
          map: map,
          title: `Location: ${results[0].formatted_address}`,
        });

        console.log("Located at:", location.lat(), location.lng());
      } else {
        console.error("Geocode error:", status);
        alert("Postcode or suburb not found. Please try again.");
      }
    });
  });

  // Handle postcode checker form submission (to show delivery information)
  function handlePostcodeCheckerSubmit(e) {
    e.preventDefault();
    var inputValEl = document.querySelector('#hf-delivery-checker-input');
    var inputVal = inputValEl.value;

    if (inputVal) {
      var deliveryBlockRightContentText = document.querySelector(".delivery-content-postcode-not-searched");
      var deliveryBlockFalse = document.querySelector(".delivery-content-postcode-not-found");
      var deliveryBlockTrue = document.querySelector(".delivery-content-postcode-found");

      // Check if the input is a postcode or suburb
      const foundPostcode = Object.keys(postcodeCoordinates).find(
        (postcode) =>
          postcode === inputVal.trim() ||
          postcodeCoordinates[postcode].suburb.toLowerCase() === inputVal.trim().toLowerCase()
      );

      if (foundPostcode) {
        // Hide the "not found" message and show the "found" message
        deliveryBlockRightContentText.style.display = 'none';
        deliveryBlockFalse.style.display = 'none';
        deliveryBlockTrue.style.display = 'block';

        // Zoom to the searched postcode location on the map
        var coordinates = postcodeCoordinates[foundPostcode];
        if (coordinates) {
          map.setCenter(new google.maps.LatLng(coordinates.lat, coordinates.lng));
          map.setZoom(14); // Adjust the zoom level as necessary

          // Place the marker on the map
          if (marker) {
            marker.setMap(null); // Remove the previous marker, if any
          }
          marker = new google.maps.Marker({
            position: coordinates,
            map: map,
            title: `Postcode: ${foundPostcode}, Suburb: ${coordinates.suburb}`,
          });
        }
      } else {
        // Hide the "found" message and show the "not found" message
        deliveryBlockRightContentText.style.display = 'none';
        deliveryBlockFalse.style.display = 'block';
        deliveryBlockTrue.style.display = 'none';
      }
    }
  }
