<style>
  .delivery-search-block {
    {% comment %}background-image: url("{{section.settings.image1 | img_url: 'master'}}");{% endcomment %}
    width: 90%;
    height: 500px;
    background-size: cover;
    padding: 3rem;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    position: relative;
    border-radius: 20px;
  }

  #map {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%; /* Full width */
    height: 100%; /* Full height */
    border-radius: 20px;
}


  .search-block button {
      height: 60px;
      width: 29%;
      border-radius: 10px;
    }

  .hf-delivery-checker-input1{
    background-color: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    font-size: 1.2rem;
    box-sizing: border-box;
    transition: box-shadow var(--duration-short) ease;
    border-radius: var(--inputs-radius);
    height: 3.5rem;
    position: relative;
    border: 0;
    margin-left: 0px! important;
  }
  
  .search-block-text-container {
    display: flex;
    justify-content: center;
    margin: 20px;
  }

  .delivery-block-container {
    display: flex;
    gap: 20px;
    justify-content: center;
    width: 90%;
    padding: 0px !important;
  }

  .delivery-block-container1 {
    background-color: #73659e;
    height: 60px;
    width: 100%;
    border-radius: 40px;
    box-shadow: rgba(0, 0, 0, 0.15) 0px 5px 15px;
    display: flex;
    justify-content: center;
    margin: 10px 0px 10px 0px;
    align-items: center;
    color: white;
  }

  .delivery-block-container2 {
    background-color: #73659e;
    height: 60px;
    width: 100%;
    border-radius: 40px;
    box-shadow: rgba(0, 0, 0, 0.15) 0px 5px 15px;
    display: flex;
    justify-content: center;
    margin: 10px;
    align-items: center;
    color: white;
  }
  
  .postcode-found-container {
    display: flex;
    justify-content: center;
    flex-direction: column;
  }

  .postcode-found-container-1 {
    display: flex;
    justify-content: center;
  }

  .postcode-found-container-2 {
    display: flex;
    justify-content: center;
    flex-direction: column;
    align-items: center;
  }
  
  .search-container {
    background-color: #f682b3;
    border-radius: 5px;
    padding: 1.3rem;;
    align-items: center !important;
    height: fit-content;
    display: flex;
    width: 46%;
  }

  .search-container-slogan {
    font-size: 50px;
    color: #434546;
    margin: 0;
    text-transform: uppercase;
    font-weight: 800;
  }

  .search-cursive-slogan {
    padding-left: 20px;
    font-size: 70px;
    font-family: Tenstars;
    color: #f283b4;
    margin: 0;
  }

  .search-container .search-block {
    padding: 0 !important;
  }

  .search-container .search-button {
    border: none;
    background-color: #fff;
    color: #000;
  }

  .delivery-content-block {
    position: relative;
    background-color: #fff;
    border-radius: 20px;
    width: 40%;
    padding: 3rem;
    height: fit-content;
  }

  .delivery-content-block h1 {
    color: #000;
    margin: 0;
    padding: 0;
    font: normal normal 800 64px/95px Poppins;
    font-size: calc(100vw * (40/1920));
    line-height: calc(100vw * (57/1920));
    letter-spacing: 0px;
  }

  .delivery-content-block span {
    color: #000;
    margin: 0;
    padding: 0;
    font: normal normal 800 64px/95px Poppins;
    font-size: calc(100vw * (40/1920));
    line-height: calc(100vw * (57/1920));
    letter-spacing: 0px;
  }

  .delivery-content-block p {
      color: #000;
      margin: 0;
      padding: 0;
      font: normal normal normal 24px/35px Poppins;
      font-size: calc(100vw * (13/1920));
      line-height: calc(100vw * (32/1920));
      letter-spacing: 0px;
      font-weight: bold;
  }

  .delivery-image {
    width: 6rem;
    height: 6rem;
    margin-bottom: -1.5rem;
  }

  .search-block-input {
    width: 40%;
  }

  .delivery-block-container1-text {
      font-size: 2vh !important; 
      padding-left: 15px; 
      font-weight: 500;
    }

    .delivery-block-container2-text {
      font-size: 2vh !important; 
      padding-left: 15px; 
      font-weight: 500;
    }
