{% schema %}
{
  "name": "Why Choose Us",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WHY CHOOSE US"
    },
    {
      "type": "image_picker",
      "id": "icon_1",
      "label": "Icon 1"
    },
    {
      "type": "image_picker",
      "id": "icon_mobile_1",
      "label": "Icon Mobile 1"
    },
    {
      "type": "text",
      "id": "title_1",
      "label": "Title 1",
      "default": "FREE SHIPPING"
    },
    {
      "type": "textarea",
      "id": "desc_1",
      "label": "Description 1",
      "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt."
    },
    {
      "type": "image_picker",
      "id": "icon_2",
      "label": "Icon 2"
    },
    {
      "type": "image_picker",
      "id": "icon_mobile_2",
      "label": "Icon Mobile 2"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "Title 2",
      "default": "GIFT MESSAGE"
    },
    {
      "type": "textarea",
      "id": "desc_2",
      "label": "Description 2",
      "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt."
    },
    {
      "type": "image_picker",
      "id": "icon_3",
      "label": "Icon 3"
    },
    {
      "type": "image_picker",
      "id": "icon_mobile_3",
      "label": "Icon Mobile 3"
    },
    {
      "type": "text",
      "id": "title_3",
      "label": "Title 3",
      "default": "PRIORITY DELIVERY"
    },
    {
      "type": "textarea",
      "id": "desc_3",
      "label": "Description 3",
      "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt."
    }
  ],
  "presets": [
    {
      "name": "Why Choose Us",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<section class="why-choose-us">
  <span class="products-showcase__title-first1">WHY</span>
  <span class="products-showcase__title-second2">CUPCAKE CENTRAL BAKERY?</span>
  <div class="benefits-container">
    <div class="benefit-item">
      {% if section.settings.icon_mobile_1 %}
        <img src="{{ section.settings.icon_mobile_1 | img_url: '800x' }}" alt="Benefit Image 1">
      {% endif %}
    </div>
    
    <div class="benefit-item">
      {% if section.settings.icon_mobile_2 %}
        <img src="{{ section.settings.icon_mobile_2 | img_url: '800x' }}" alt="Benefit Image 2">
      {% endif %}
    </div>

    <div class="benefit-item">
      {% if section.settings.icon_mobile_3 %}
        <img src="{{ section.settings.icon_mobile_3 | img_url: '800x' }}" alt="Benefit Image 3">
      {% endif %}
    </div>
  </div>
</section>

<style>
.why-choose-us {
  background: #fef8f2;
  text-align: center;
  padding: 50px 20px;
}


  .products-showcase__title-first1  {
  margin-bottom: 40px;
  margin-top: 0px;
  font-family: Beefcakes-Regular;
  font-size: 3vw;
  color: #f6bb00;
  font-weight: bold;
  margin-right: 0.5rem;
}

.products-showcase__title-second2 {
  margin-bottom: 50px;
  margin-top: 0px;
  font-family: Beefcakes-Regular;
  font-size: 3vw;
  color: #F75533;
  font-weight: bold;
}
.benefits-container {
  display: flex;
  justify-content: center;
  gap: 40px;
  margin: auto;
  margin-top: 30px;
}

/* Desktop Styling */
.benefit-item {
  background: white;
  border-radius: 14px;
  box-shadow: 0px 5px 5px #00000029;
  overflow: hidden;
}

.benefit-item img {
  width: 100%;
  max-width: 100%;
  height: auto;
  display: block;
}

/* Mobile: Full-Width Images */
@media (max-width: 768px) {
  .benefits-container {
    flex-direction: column;
    gap: 20px;
    margin-top: -31px;
  }

  .benefit-item {
    flex-direction: column;
    background: white;
    border-radius: 14px;
    box-shadow: 0px 5px 5px #00000029;
    overflow: hidden;
  }

  /* Make the image full width */
  .benefit-item img {
    width: 100%;
    max-width: 100%;
    height: auto;
    display: block;
  }
}
</style>


